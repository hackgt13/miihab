# Copy to .env (gitignored) and fill in. Read by the coordinator at startup via
# --env-file-if-exists, so it works whatever shell launches scripts/demo.sh.

# Optional. Without it the friends panel still works: the spotlight falls back
# to the old rule, and activity lines and conversation recaps stay hidden.
ANTHROPIC_API_KEY=

# Optional. Meta's Muse Spark writes the friends lines instead of Claude (developers.meta.com, Meta Model API).
MUSE_API_KEY=

# Optional. A Meta (Facebook) app id adds "Share to Facebook" to a milestone card (coordinator/share.ts). Public,
# not a secret: developers.facebook.com → your app. The card is the page in share-page/, published with GitHub Pages.
META_APP_ID=
META_SHARE_URL=https://hackgt13.github.io/miihab-share/
