# ElevenLabs
ELEVENLABS_API_KEY=your_api_key_here
# Leave empty until you run: npm run create-agent
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
# For running migrations via: npm run migrate
# Settings → Database → Connection string → URI (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Server
VOICE_PORT=8768

# Coordinator (care plan + measured results)
COORDINATOR_URL=http://127.0.0.1:8766
