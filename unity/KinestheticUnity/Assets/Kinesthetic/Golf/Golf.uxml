<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Golf.uss" />
    <ui:VisualElement class="screen" picking-mode="Ignore">
        <ui:VisualElement class="player-banner" picking-mode="Ignore">
            <ui:Label name="score" text="YOU 0 — 0 FRIEND" class="score" />
        </ui:VisualElement>
        <ui:VisualElement class="hole-info" picking-mode="Ignore">
            <ui:Label text="Hole 1" class="hole-number outlined" />
            <ui:Label text="Par 4" class="par outlined" />
        </ui:VisualElement>
        <ui:VisualElement class="shot-info" picking-mode="Ignore">
            <ui:Label name="heading" text="YOUR TURN" class="turn-heading outlined" />
            <ui:Label name="stroke" text="Stroke 1" class="stroke outlined" />
            <ui:Label name="lie" text="Tee" class="lie outlined" />
            <ui:Label name="distance" text="To the pin" class="distance outlined" />
        </ui:VisualElement>
        <ui:VisualElement class="map-panel" picking-mode="Ignore">
            <ui:Label text="HOLE 1" class="map-title" />
            <ui:VisualElement name="course-map" class="course-map" picking-mode="Ignore" />
            <ui:Label text="● YOU    ● FRIEND" class="map-key" />
        </ui:VisualElement>
        <ui:VisualElement class="power-panel" picking-mode="Ignore">
            <ui:Label text="POWER" class="power-title outlined" />
            <ui:VisualElement name="power-meter" class="power-meter" picking-mode="Ignore" />
            <ui:Label name="power-value" text="0%" class="power-value outlined" />
        </ui:VisualElement>
        <ui:VisualElement class="club-panel">
            <ui:Image name="driver-artwork" class="club-image" picking-mode="Ignore" />
            <ui:VisualElement class="row aim-row">
                <ui:Button name="aim-left" text="◀" class="aim-button" />
                <ui:Label text="Aim" class="outlined" />
                <ui:Button name="aim-right" text="▶" class="aim-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="device-chip" class="device-chip">
            <ui:VisualElement class="device-dot" />
            <ui:Label name="device-status" text="Connecting…" />
            <ui:Button name="setup-open" text="Quick guide" />
        </ui:VisualElement>
        <ui:VisualElement class="footer">
            <ui:Label name="guidance" text="Connecting…" class="footer-guidance" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="golf-setup" class="golf-overlay">
            <ui:VisualElement class="setup-sheet">
                <ui:VisualElement class="setup-hero">
                    <ui:Label text="REHABMII SPORTS" class="sheet-eyebrow" />
                    <ui:Label text="Today we will&#10;practice golf." class="setup-title" />
                    <ui:Label text="GOLF  /  HOLE 1  /  PAR 4" class="setup-tag" />
                    <ui:VisualElement class="hero-space" />
                    <ui:Label text="Take turns with a friend." class="hero-detail" />
                </ui:VisualElement>
                <ui:VisualElement class="setup-content">
                    <ui:Label text="Three easy steps" class="sheet-title" />
                    <ui:Label text="Aim. Swing gently. Take turns." class="sheet-copy" />
                    <ui:VisualElement name="setup-camera" class="setup-step">
                        <ui:Label text="1" class="step-badge" />
                        <ui:VisualElement class="step-copy"><ui:Label text="Get in view" class="step-heading" /><ui:Label text="" class="step-state" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="setup-motion" class="setup-step">
                        <ui:Label text="2" class="step-badge" />
                        <ui:VisualElement class="step-copy"><ui:Label text="Pick up your club" class="step-heading" /><ui:Label text="" class="step-state" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="setup-calibration" class="setup-step">
                        <ui:Label text="3" class="step-badge" />
                        <ui:VisualElement class="step-copy"><ui:Label text="Hold still" class="step-heading" /><ui:Label text="" class="step-state" /></ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="assist-row"><ui:Button name="sound-toggle" text="Sound assist: on" /><ui:Label name="audio-status" text="" class="assist-status" /></ui:VisualElement>
                    <ui:Label name="setup-status" text="Connecting…" class="setup-status" />
                    <ui:VisualElement class="sheet-actions"><ui:Button name="setup-retry" text="Try again" class="hidden" /><ui:Button name="setup-close" text="Got it" class="hidden" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="golf-results" class="golf-overlay hidden">
            <ui:VisualElement class="results-sheet">
                <ui:Label text="✓" class="result-medallion" />
                <ui:Label text="HOLE COMPLETE" class="sheet-eyebrow result-eyebrow" />
                <ui:Label name="round-title" text="A round well played." class="sheet-title result-title" />
                <ui:Label text="Hole complete." class="sheet-copy" />
                <ui:VisualElement class="score-cards">
                    <ui:VisualElement class="score-card"><ui:Label text="YOU" class="score-name" /><ui:Label name="round-you" text="—" class="result-score" /><ui:Label text="strokes" class="score-unit" /><ui:Label name="round-you-par" text="" class="score-par" /></ui:VisualElement>
                    <ui:VisualElement class="score-card friend-card"><ui:Label text="YOUR FRIEND" class="score-name" /><ui:Label name="round-friend" text="—" class="result-score" /><ui:Label text="strokes" class="score-unit" /><ui:Label name="round-friend-par" text="" class="score-par" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:Label text="HOLE 1   ·   PAR 4" class="result-footnote" />
                <ui:VisualElement class="sheet-actions"><ui:Button name="round-menu" text="Choose activity" /><ui:Button name="round-replay" text="Play again  ›" class="sheet-primary" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
