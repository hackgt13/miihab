.screen { flex-grow: 1; color: white; font-size: 18px; -unity-font-style: bold; }
.outlined { -unity-text-outline-width: 1.4px; -unity-text-outline-color: rgba(20, 40, 48, .85); }
.player-banner { position: absolute; left: 28px; top: 28px; width: 305px; background-color: rgba(12, 29, 43, .88); border-top-width: 3px; border-bottom-width: 3px; border-right-width: 7px; border-color: #76d5f6; padding: 12px 18px; border-bottom-right-radius: 22px; }
.score { font-size: 23px; color: white; -unity-text-align: middle-center; }
.hole-info { position: absolute; left: 30px; top: 106px; }
.hole-number { font-size: 35px; }
.par { font-size: 24px; color: #fff6b0; }
.shot-info { position: absolute; top: 32px; left: 26%; right: 22%; align-items: center; }
.turn-heading { font-size: 48px; margin-bottom: 3px; letter-spacing: 1px; }
.stroke { font-size: 25px; margin-bottom: 10px; color: #fff6c2; }
.lie { font-size: 20px; letter-spacing: 2px; }
.distance { font-size: 22px; border-top-width: 1px; border-top-color: rgba(255,255,255,.7); padding: 4px 25px; margin-top: 4px; }
.map-panel { position: absolute; right: 35px; top: 28px; width: 208px; background-color: rgba(24,57,49,.82); border-width: 2px; border-color: rgba(238,255,242,.95); border-radius: 4px; }
.map-title { -unity-text-align: middle-center; font-size: 14px; height: 26px; letter-spacing: 2px; }
.course-map { height: 333px; overflow: hidden; }
.map-key { font-size: 11px; -unity-text-align: middle-center; height: 25px; color: #fff4c4; }
.power-panel { position: absolute; left: 37px; top: 32%; width: 76px; align-items: center; }
.power-title { font-size: 13px; letter-spacing: 1px; }
.power-meter { width: 64px; height: 245px; margin-top: 10px; }
.power-value { font-size: 24px; margin-top: 7px; }
.club-panel { position: absolute; left: 26px; bottom: 35px; width: 230px; align-items: center; }
.club-image { width: 130px; height: 100px; }
.row { flex-direction: row; align-items: center; }
.club-row { justify-content: center; }
.club { font-size: 30px; min-width: 125px; -unity-text-align: middle-center; }
.club-mode { font-size: 14px; -unity-font-style: bold; margin-top: 3px; -unity-text-outline-width: 0.5px; }
.mount-hint { font-size: 13px; color: #c6eaff; white-space: normal; margin-bottom: 8px; -unity-font-style: normal; }
.aim-row { margin-top: 4px; }
.aim-row Label { margin-left: 15px; margin-right: 15px; font-size: 17px; }
Button { background-color: #f5fbff; color: #28608b; border-width: 2px; border-color: #96cce5; border-radius: 7px; padding: 7px 12px; margin: 3px; font-size: 15px; -unity-font-style: bold; }
Button:hover { background-color: #c9edff; border-color: white; }
Button:active { background-color: #87d1ee; }
Button:disabled { background-color: #d3dee2; color: #81969f; border-color: #adbec5; }
Button.primary { background-color: #b6ecff; border-color: white; }
Button.round-button { width: 35px; height: 35px; padding: 0; border-radius: 18px; font-size: 27px; }
Button.aim-button { font-size: 20px; width: 48px; height: 44px; padding: 0; border-radius: 12px; }
.footer { position: absolute; bottom: 18px; left: 26%; right: 23%; align-items: center; }
.footer-guidance { padding: 7px 14px; margin-bottom: 8px; background-color: rgba(14,38,53,.8); border-radius: 10px; font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
#camera-start { width: 100px; height: 82px; padding: 0; border-radius: 25px; border-width: 4px; border-color: #82ceef; align-items: center; justify-content: center; background-color: #f5fbff; }
#camera-start:hover { background-color: #d5f3ff; border-color: white; }
#camera-start:active { background-color: #a6e2fa; }
#camera-start.ready { border-color: #8bf0b1; }
.camera-icon { width: 57px; height: 43px; }
.camera-top { position: absolute; left: 16px; top: 0; width: 26px; height: 10px; background-color: #377ba6; border-radius: 4px; }
.camera-body { position: absolute; left: 0; top: 7px; width: 57px; height: 36px; background-color: #377ba6; border-radius: 7px; align-items: center; justify-content: center; }
.camera-lens { width: 25px; height: 25px; border-width: 4px; border-color: #f5fbff; border-radius: 14px; }

.device-chip { position: absolute; right: 35px; bottom: 58px; flex-direction: row; align-items: center; padding: 8px 10px 8px 14px; background-color: rgba(255,255,255,.97); border-radius: 18px; color: #547384; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); -unity-font-style: normal; }
.device-chip Label { font-size: 12px; max-width: 185px; white-space: normal; }
.device-dot { width: 8px; height: 8px; border-radius: 4px; background-color: #d2ab57; margin-right: 8px; }
.device-chip.connected .device-dot { background-color: #51ac7b; }
.device-chip Button { font-size: 12px; padding: 5px 12px; margin-left: 12px; border-radius: 14px; }
.golf-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(29,62,80,.40); color: #426a7d; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); -unity-font-style: normal; }
Label { margin: 0; padding: 0; }
.setup-sheet { flex-direction: row; width: 1050px; max-width: 92%; background-color: white; border-width: 3px; border-bottom-width: 7px; border-color: #bce2f3; border-radius: 28px; overflow: hidden; }
.setup-hero { width: 355px; flex-shrink: 0; padding: 32px; background-image: url("project://database/Assets/Kinesthetic/Menu/Art/Golf.png"); -unity-background-scale-mode: scale-and-crop; background-color: #357f95; -unity-background-image-tint-color: #8cafbb; }
.sheet-eyebrow { font-size: 11px; letter-spacing: 2px; color: white; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.setup-title { font-size: 37px; white-space: normal; color: white; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); margin-top: 25px; -unity-text-outline-width: 0.5px; -unity-text-outline-color: #305966; }
.setup-tag { font-size: 10px; color: white; background-color: rgba(27,71,69,.75); padding: 10px 12px; margin-top: 18px; border-radius: 10px; align-self: flex-start; }
.hero-space { flex-grow: 1; min-height: 80px; }
.hero-detail { color: white; font-size: 15px; white-space: normal; background-color: rgba(27,71,69,.75); padding: 12px; border-radius: 12px; }
.setup-content { flex-grow: 1; flex-shrink: 1; padding: 28px 32px; }
.sheet-title { font-size: 30px; color: #278fbf; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-copy { font-size: 15px; color: #638394; white-space: normal; margin-top: 8px; }
.setup-step { flex-direction: row; align-items: center; padding: 13px 0; border-bottom-width: 1px; border-bottom-color: #e7f0f5; }
.step-badge { width: 36px; height: 36px; flex-shrink: 0; border-radius: 18px; background-color: #edf5fa; color: #73a0b7; font-size: 19px; -unity-text-align: middle-center; margin-right: 15px; }
.step-ready .step-badge { color: #41956b; background-color: #e3f4e9; }
.step-copy { flex-grow: 1; flex-shrink: 1; }
.step-heading { font-size: 17px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.step-state { font-size: 13px; color: #638394; white-space: normal; margin-top: 4px; }
.assist-row { flex-direction: row; align-items: center; margin-top: 10px; }
.assist-status { flex-grow: 1; flex-shrink: 1; font-size: 10px; white-space: normal; color: #638394; margin-left: 10px; }
.setup-status { font-size: 12px; white-space: normal; color: #527e94; padding: 12px 0; min-height: 45px; }
.golf-overlay Button { border-radius: 22px; border-width: 2px; border-bottom-width: 4px; border-color: #b4dcea; padding: 10px 18px; font-size: 15px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); -unity-font-style: normal; background-color: white; color: #3289b6; margin: 0; }
.golf-overlay Button:hover, .golf-overlay Button:focus { border-color: #249acb; background-color: #edfaff; }
.golf-overlay Button:disabled { opacity: .45; }
.golf-overlay Button.sheet-primary { color: white; background-color: #35a8d6; border-color: #2493c4; }
.golf-overlay Button.sheet-primary:hover, .golf-overlay Button.sheet-primary:focus { background-color: #218fc1; border-color: #146487; }
.sheet-actions { flex-direction: row; justify-content: flex-end; margin-top: 18px; }
.sheet-actions Button { margin-left: 12px; }
.assist-row Button { font-size: 12px; padding: 6px 12px; }
.results-sheet { width: 660px; padding: 30px 38px; border-width: 3px; border-bottom-width: 7px; border-color: #bce2f3; background-color: white; border-radius: 28px; align-items: center; }
.result-medallion { width: 66px; height: 66px; border-radius: 33px; background-color: #e5f5fc; color: #37a4d2; font-size: 38px; -unity-text-align: middle-center; }
.result-eyebrow { color: #6e9bad; margin-top: 18px; }
.result-title { margin-top: 10px; font-size: 32px; }
.score-cards { flex-direction: row; align-self: stretch; margin-top: 25px; }
.score-card { flex-grow: 1; flex-basis: 0; padding: 20px; align-items: center; border-radius: 18px; background-color: #edf8fd; border-bottom-width: 4px; border-bottom-color: #bbdeee; }
.friend-card { margin-left: 18px; background-color: #fff8e9; border-bottom-color: #eddeaf; }
.score-name { font-size: 12px; letter-spacing: 1px; }
.result-score { font-size: 65px; color: #2b99c8; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.friend-card .result-score { color: #b9933b; }
.score-unit { font-size: 12px; color: #7893a0; margin-top: -6px; }
.score-par { font-size: 15px; margin-top: 15px; }
.result-footnote { margin-top: 18px; font-size: 11px; color: #7d98a7; letter-spacing: 1px; }
.hidden { display: none; }
