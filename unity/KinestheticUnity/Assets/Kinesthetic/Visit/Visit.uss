/* Layout for the visit's boards (VisitWhiteboard, VisitSpeech, VisitDock). Each lays out at its station's
   density — px/m = 1000 / distance — so these sizes fit the board they are on. Layout only: the look is
   the components', and the whiteboard's white is the physical board behind the panel. */
.board { flex-grow: 1; }

/* Whiteboard, 643 x 464 px at 2.8 m: six rows under the title (visit.ts BOARD_LIMIT). */
.visit-board { margin: 26px 34px; }
.visit-title { margin-top: 4px; margin-bottom: 14px; }
.visit-updates { flex-grow: 1; }
.visit-update { flex-direction: row; align-items: flex-start; margin-bottom: 7px; }
.visit-update-tag { width: 96px; flex-shrink: 0; margin-top: 2px; align-items: flex-start; }
.visit-update-copy { flex-grow: 1; flex-shrink: 1; }
.visit-update.unrevealed { display: none; }
.visit-date { align-self: flex-end; }

/* Speech, about 1.0 x 0.5 m over the therapist's head. The balloon sits on the bottom edge, so its tail
   points down at the therapist standing beneath it. */
.visit-speech { justify-content: flex-end; }
.visit-speech.quiet .visit-bubble { display: none; }
.visit-line { margin-top: 4px; }

/* Dock, 750 x 350 px at 1.2 m: the controls, and the relay under them once the board is done. */
.visit-dock { flex-direction: row; align-items: center; }
.visit-dock-copy { flex-grow: 1; flex-shrink: 1; }
.visit-action { margin-left: 16px; flex-shrink: 0; }
.visit-relay { margin-top: 8px; }
.visit-quick { flex-direction: row; flex-wrap: wrap; margin-top: 8px; }
.visit-quick-reply { margin-right: 8px; margin-bottom: 6px; }
.visit-write { flex-direction: row; align-items: center; margin-top: 4px; }
.visit-field { flex-grow: 1; flex-shrink: 1; }
.visit-send { margin-left: 10px; flex-shrink: 0; }
