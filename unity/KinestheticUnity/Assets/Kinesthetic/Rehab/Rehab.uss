/* Layout for the studio's boards (RehabDock, RehabCrown, RehabFocus, RehabBrief). Each board lays out
   at its station's density — px/m = 1000 / distance — so these widths are what fits the board it is on,
   not a 1600x900 screen. Layout only: the look is the components'. */
.board { flex-grow: 1; }

/* Dock, 667 x 283 px at 1.2 m. */
.dock-chrome { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.coaching-dock { flex-direction: row; align-items: center; }
.cue-step { align-self: center; margin-right: 20px; align-items: center; }
.hold-ring { width: 72px; height: 72px; margin-top: 8px; }
.coaching-copy { flex-grow: 1; flex-shrink: 1; }
.status { margin-top: 4px; }
.session-action { margin-left: 22px; flex-shrink: 0; }
.voice-caption { margin-top: 8px; }
.voice-line { margin-top: 6px; }

/* Crown, 300 x 130 px at 1.0 m, riding above the view. A row: the count, then the run and the best hold. */
.crown { flex-direction: row; align-items: center; justify-content: center; }
.crown-count { margin-right: 18px; }
.crown-side { align-items: flex-start; justify-content: center; }

/* Brief, 727 x 836 px at 0.55 m. Inside arm's reach, so the sheet reads as held rather than mounted.
   The host centres it; the sheet is as tall as what is on it. */
.briefing-host { flex-grow: 1; justify-content: center; }

/* Focus, 857 x 571 px at 1.4 m. The card is the board. */
.summary-card { flex-grow: 1; align-items: center; justify-content: center; }
.summary-badge { align-self: center; margin-bottom: 14px; }
.summary-progress { margin-top: 8px; }
.summary-metrics { flex-direction: row; width: 100%; margin-top: 28px; margin-bottom: 28px; }
.summary-metric { flex-grow: 1; flex-basis: 0; align-items: center; }
.summary-actions { flex-direction: row; }
.summary-close { margin-left: 16px; }

/* The corner figure sits opposite the eyebrow, on the same line. Layout only. */
.corner-row { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; }
.match-readout { align-items: flex-end; }

/* The trunk's share, on the live board. Layout only; the bar and the figure are components. */
.lean-row { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 8px; }
.lean-meter { flex-grow: 1; margin-left: 10px; }
