/* Layout for the studio's boards (RehabDock, RehabPlan, RehabMeasure, RehabFocus). Each board lays out
   at its station's density — px/m = 1000 / distance — so these widths are what fits the board it is on,
   not a 1600x900 screen. Layout only: the look is the components'. */
.board { flex-grow: 1; }

/* Dock, 667 x 283 px at 1.2 m. */
.dock-chrome { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.view-toggle { flex-shrink: 0; }
.coaching-dock { flex-direction: row; align-items: center; }
.cue-step { align-self: center; margin-right: 20px; }
.coaching-copy { flex-grow: 1; flex-shrink: 1; }
.status { margin-top: 4px; }
.session-action { margin-left: 22px; flex-shrink: 0; }
.voice-caption { margin-top: 8px; }
.voice-line { margin-top: 6px; }

/* Plan, 440 x 220 px at 2.0 m. */
.exercise-card { flex-grow: 1; }
.intro { margin-top: 12px; margin-bottom: 2px; }
.exercise-meta { flex-direction: row; align-items: center; margin-top: 14px; }
.plan { flex-shrink: 1; }
.side-tag { margin-right: 12px; }
.studio-screen.playing .intro { display: none; }

/* Measure, 320 x 400 px at 1.5 m. */
.progress-card { flex-grow: 1; align-items: center; }
.rep-ring { width: 160px; height: 160px; margin-top: 14px; }
.progress-note { margin-top: 12px; }
.angle-details { width: 100%; margin-top: 18px; align-items: center; }
.angle-meter { width: 100%; margin-top: 10px; }
.angle-note { margin-top: 10px; }

/* Focus, 657 x 486 px at 1.4 m. The card is the board. */
.summary-card { flex-grow: 1; align-items: center; }
.summary-badge { align-self: center; margin-bottom: 12px; }
.summary-subtitle, .summary-plan, .summary-progress { margin-top: 6px; }
.summary-metrics { flex-direction: row; width: 100%; margin-top: 16px; margin-bottom: 12px; }
.summary-metric { flex-grow: 1; align-items: center; }
.summary-notes { max-height: 72px; width: 100%; flex-shrink: 1; }
.summary-saved { margin-top: 10px; }
.summary-actions { flex-direction: row; margin-top: 16px; }
.summary-close { margin-left: 14px; }
