<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kinesthetic.UI">
    <Style src="../Palette.uss" />
    <Style src="../UI/Base.uss" />
    <Style src="Rehab.uss" />
    <ui:VisualElement name="studio-screen" class="studio-screen" picking-mode="Ignore">
        <k:KSurface class="exercise-card" density="Comfortable">
            <k:KEyebrow text="REHABMII / MOVEMENT STUDIO" />
            <k:KText text="Today we will practice" tone="Soft" class="intro" />
            <k:KText name="title" text="Shoulder raises" size="Title" />
            <ui:VisualElement class="exercise-meta">
                <ui:VisualElement class="side-tag"><k:KTag name="side-label" text="RIGHT ARM" tone="Info" /></ui:VisualElement>
                <k:KText name="plan" text="8 reps · 85° target" size="Caption" tone="Soft" class="plan" />
            </ui:VisualElement>
        </k:KSurface>
        <k:KChip name="sensor-status" text="Connecting to AirPod…" state="Live" class="sensor-status" />
        <k:KSurface class="progress-card" density="Compact">
            <k:KEyebrow text="YOUR SET" />
            <k:KArc name="rep-ring" form="Segmented" tone="Good" segments="8" class="rep-ring">
                <k:KReadout name="rep-count" value="0" caption="of 8 reps" size="Large" />
            </k:KArc>
            <k:KText name="progress-note" text="One at a time." size="Caption" tone="Soft" class="progress-note" />
            <ui:VisualElement name="angle-details" class="angle-details hidden">
                <k:KReadout name="angle-readout" value="—" caption="Target 85°" size="Compact" />
                <k:KMeter name="angle-meter" form="Bar" class="angle-meter" />
                <k:KText name="angle-note" text="Raise slowly" size="Caption" tone="Soft" class="angle-note" />
            </ui:VisualElement>
        </k:KSurface>
        <k:KSurface name="hud-coach" class="voice-caption hidden" tone="Glass" density="Compact" picking-mode="Ignore">
            <k:KEyebrow text="ALEX · YOUR COACH" backdrop="Dark" />
            <k:KText name="hud-coach-line" text="" tone="OnDark" class="voice-line" />
        </k:KSurface>
        <k:KSurface name="coaching-dock" class="coaching-dock" density="Compact">
            <ui:VisualElement class="cue-step"><k:KTag name="cue-step" text="GET READY" tone="Info" /></ui:VisualElement>
            <ui:VisualElement class="coaching-copy">
                <k:KText name="cue-title" text="Secure your AirPod." size="Heading" />
                <k:KText name="status" text="Rest your arm. We’ll begin when you’re ready." tone="Soft" class="status" />
            </ui:VisualElement>
            <k:KButton name="start" text="Connecting…" tone="Secondary" size="Medium" class="session-action" />
        </k:KSurface>
        <k:KButton name="view-toggle" text="Seated view" tone="Secondary" size="Small" class="view-toggle" />
        <k:KSurface name="summary-card" tone="Scrim" density="Flush" class="summary-overlay hidden">
            <k:KSurface class="summary-card">
                <k:KTag text="SESSION SAVED" tone="Good" class="summary-badge" />
                <k:KText name="summary-title" text="Your set is complete" size="Title" />
                <k:KText name="summary-subtitle" text="Your session summary." tone="Soft" class="summary-subtitle" />
                <k:KText name="summary-plan" text="" size="Caption" tone="Soft" class="summary-plan" />
                <k:KText name="summary-progress" text="" tone="Success" class="summary-progress hidden" />
                <ui:VisualElement class="summary-metrics">
                    <k:KReadout name="summary-valid" value="—" caption="Counted reps" class="summary-metric" />
                    <k:KReadout name="summary-attempted" value="—" caption="Attempts" class="summary-metric" />
                    <k:KReadout name="summary-peak" value="—" caption="Median peak" class="summary-metric" />
                </ui:VisualElement>
                <ui:ScrollView class="summary-notes" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto"><k:KText name="summary" text="" size="Caption" tone="Soft" /></ui:ScrollView>
                <k:KText name="summary-saved" text="Session saved" size="Caption" tone="Soft" class="summary-saved" />
                <ui:VisualElement class="summary-actions">
                    <k:KButton name="summary-menu" text="Choose activity" />
                    <ui:VisualElement class="summary-close"><k:KButton name="summary-close" text="Back to studio" tone="Primary" /></ui:VisualElement>
                </ui:VisualElement>
            </k:KSurface>
        </k:KSurface>
    </ui:VisualElement>
</ui:UXML>
