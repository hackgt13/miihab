<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kinesthetic.UI">
    <Style src="../Palette.uss" />
    <Style src="../UI/Base.uss" />
    <Style src="Rehab.uss" />
    <!-- Focus station: the session summary, a modal at reading distance. The whole board is the card; it
         is hidden until a set ends, so the station is empty air the rest of the time. The briefing is the
         session's other document and stands nearer, on its own board — a page handed to you is held, not
         looked at across the room. No scrim: a board standing in a room does not dim the room. -->
    <ui:VisualElement name="focus-board" class="board" picking-mode="Ignore">
        <!-- The end of a set says four things and no more: that it is saved, how it went in a word, the three
             numbers, and what is next. Everything else (per-rep reasons, form breakdowns) is the care team's,
             in the portal. While this is up it is the only board showing (RehabSession.UpdateStudioUI). -->
        <k:KSheet name="summary-card" class="summary-card" entrance="Below" density="Comfortable">
            <k:KTag name="summary-badge" text="SESSION SAVED" tone="Good" class="summary-badge" />
            <k:KText name="summary-title" text="Set complete" size="Title" />
            <k:KText name="summary-progress" text="" tone="Success" class="summary-progress hidden" />
            <ui:VisualElement class="summary-metrics">
                <k:KReadout name="summary-valid" value="—" caption="Reps counted" size="Large" class="summary-metric" />
                <k:KReadout name="summary-attempted" value="—" caption="Attempts" size="Large" class="summary-metric" />
                <k:KReadout name="summary-peak" value="—" caption="Typical reach" size="Large" class="summary-metric" />
            </ui:VisualElement>
            <ui:VisualElement class="summary-actions">
                <k:KButton name="summary-menu" text="Done" size="Large" />
                <ui:VisualElement class="summary-close"><k:KButton name="summary-close" text="Practice again" tone="Primary" size="Large" /></ui:VisualElement>
            </ui:VisualElement>
        </k:KSheet>
    </ui:VisualElement>
</ui:UXML>
