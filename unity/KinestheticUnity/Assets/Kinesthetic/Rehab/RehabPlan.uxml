<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kinesthetic.UI">
    <Style src="../Palette.uss" />
    <Style src="../UI/Base.uss" />
    <Style src="Rehab.uss" />
    <!-- The exercise card: what today's practice is and the plan it came from. Stands front-right, above
         the live figures, because the mirror has the left. Named studio-screen because it carries the
         screen's "playing" state, which folds the introduction away once the set is under way. -->
    <ui:VisualElement name="studio-screen" class="board studio-screen" picking-mode="Ignore">
        <k:KSurface class="exercise-card" density="Comfortable" picking-mode="Ignore">
            <k:KEyebrow text="REHABMII / MOVEMENT STUDIO" />
            <k:KText text="Today we will practice" tone="Soft" class="intro" />
            <k:KText name="title" text="Shoulder raises" size="Title" />
            <ui:VisualElement class="exercise-meta">
                <ui:VisualElement class="side-tag"><k:KTag name="side-label" text="RIGHT ARM" tone="Info" /></ui:VisualElement>
                <k:KText name="plan" text="8 reps · 85° target" size="Caption" tone="Soft" class="plan" />
            </ui:VisualElement>
        </k:KSurface>
    </ui:VisualElement>
</ui:UXML>
