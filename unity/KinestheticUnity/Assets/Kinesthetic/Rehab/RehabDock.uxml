<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kinesthetic.UI">
    <Style src="../Palette.uss" />
    <Style src="../UI/Base.uss" />
    <Style src="Rehab.uss" />
    <!-- Dock station: what to do now. The connection chip rides the top edge, the cue, status and primary
         action sit in the middle, and the coach's spoken line appears beneath. -->
    <ui:VisualElement name="dock-board" class="board" picking-mode="Ignore">
        <ui:VisualElement class="dock-chrome" picking-mode="Ignore">
            <k:KChip name="sensor-status" text="Connecting to AirPod…" state="Live" />
        </ui:VisualElement>
        <k:KSurface name="coaching-dock" class="coaching-dock" density="Compact">
            <!-- The step, and under it the hold timer: a ring that fills while the arm stays in the band. -->
            <ui:VisualElement class="cue-step">
                <k:KTag name="cue-step" text="GET READY" tone="Info" />
                <k:KArc name="hold-ring" form="Continuous" tone="Progress" class="hold-ring hidden">
                    <k:KReadout name="hold-readout" value="0.0" caption="s" size="Compact" />
                </k:KArc>
            </ui:VisualElement>
            <ui:VisualElement class="coaching-copy">
                <k:KText name="cue-title" text="Secure your AirPod." size="Heading" />
                <k:KText name="status" text="Rest your arm. We’ll begin when you’re ready." tone="Soft" class="status" />
            </ui:VisualElement>
            <k:KButton name="start" text="Connecting…" tone="Primary" size="Medium" class="session-action" />
        </k:KSurface>
        <k:KSurface name="hud-coach" class="voice-caption hidden" tone="Glass" density="Compact" picking-mode="Ignore">
            <k:KEyebrow name="hud-coach-state" text="ALEX · YOUR COACH" backdrop="Dark" />
            <k:KText name="hud-coach-line" text="" tone="OnDark" class="voice-line" />
        </k:KSurface>
    </ui:VisualElement>
</ui:UXML>
