.bowling { flex-grow: 1; color: #0E1C36; padding: 28px 36px; }
.top { flex-direction: row; align-items: center; justify-content: space-between; }
.brand { background-color: rgba(253, 251, 246, 0.96); border-radius: 20px; padding: 15px 26px; border-bottom-width: 4px; border-bottom-color: #5C9EC6; }
.eyebrow { color: #6B7EA4; font-size: 13px; -unity-font-style: bold; letter-spacing: 3px; }
.title { font-size: 34px; -unity-font-style: bold; }
.top-actions { flex-direction: row; align-items: center; }
.device { color: #F8F3E8; background-color: #33456A; border-radius: 18px; padding: 12px 20px; font-size: 17px; margin-right: 10px; }
.device.ready { background-color: #3A8B41; }
Button { color: #0E1C36; background-color: #FDFBF6; border-width: 2px; border-color: #9FC8E0; border-radius: 18px; padding: 12px 22px; font-size: 18px; -unity-font-style: bold; margin: 4px; }
Button:hover { background-color: #EAF3F9; border-color: #5C9EC6; }
Button:active { background-color: #CFE4F0; }
Button:focus { border-color: #2274A5; }
Button:disabled { opacity: 0.45; }
.scoreboard { flex-direction: row; align-self: center; margin-top: 15px; border-radius: 16px; background-color: rgba(253, 251, 246, 0.96); padding: 9px 12px; }
.frame { width: 75px; align-items: center; border-right-width: 1px; border-right-color: #B4BFD3; padding: 4px; }
.frame.active { background-color: #CFE4F0; border-radius: 10px; }
.frame-number { font-size: 12px; color: #6B7EA4; }
.frame-marks { font-size: 17px; height: 25px; -unity-font-style: bold; }
.frame-score { font-size: 19px; -unity-font-style: bold; }
.total { width: 90px; align-items: center; padding: 4px; }
.total-score { font-size: 28px; -unity-font-style: bold; color: #0E1C36; }
.spacer { flex-grow: 1; }
.bottom { flex-direction: row; align-items: flex-end; justify-content: space-between; }
.metric { border-radius: 18px; background-color: rgba(253, 251, 246, 0.96); padding: 17px 24px; min-width: 230px; }
.metric-value { font-size: 34px; -unity-font-style: bold; }
.small { color: #6B7EA4; font-size: 15px; margin-top: 3px; }
.cue { background-color: rgba(253, 251, 246, 0.97); border-radius: 22px; padding: 18px 32px; margin: 0 20px; align-items: center; flex-shrink: 1; }
.cue-title { font-size: 28px; -unity-font-style: bold; white-space: normal; -unity-text-align: middle-center; }
.overlay { position: absolute; top: 0; right: 0; bottom: 0; left: 0; align-items: center; justify-content: center; background-color: rgba(14, 28, 54, 0.45); }
.card { width: 570px; padding: 34px 40px; background-color: #FDFBF6; border-radius: 28px; border-width: 3px; border-color: #9FC8E0; }
.card-title { font-size: 39px; -unity-font-style: bold; margin: 7px 0 14px; white-space: normal; }
.step { flex-direction: row; align-items: center; margin: 11px 0; }
.number { width: 42px; height: 42px; border-radius: 21px; background-color: #CFE4F0; color: #0E1C36; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 22px; margin-right: 14px; }
.step-text { font-size: 21px; white-space: normal; flex-shrink: 1; }
.setup-status { margin-top: 20px; padding: 17px; border-radius: 14px; background-color: #EAF3F9; color: #0E1C36; -unity-text-align: middle-center; font-size: 20px; -unity-font-style: bold; white-space: normal; }
.fine { color: #6B7EA4; font-size: 14px; margin-top: 12px; -unity-text-align: middle-center; white-space: normal; }
.actions { flex-direction: row; justify-content: center; margin-top: 18px; }
.primary { background-color: #2274A5; color: #FDFBF6; border-color: #5C9EC6; }
.primary:hover { background-color: #185A83; color: #FDFBF6; }
.result-score { font-size: 82px; -unity-font-style: bold; color: #0E1C36; -unity-text-align: middle-center; }
.hidden { display: none; }
