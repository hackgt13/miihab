<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Palette.uss" />
    <ui:Style src="MainMenu.uss" />
    <!-- The activity gallery, standing two turns to the left of the board — coaching took the slot next to
         it. It was a modal sheet over the board; as a pane it needs no shade behind it, because nothing is
         behind it. The board's own button reaches it in one press whatever the angle. -->
    <ui:VisualElement name="gallery-pane" class="pane-screen">
        <ui:VisualElement class="sheet">
            <ui:Label text="What would you like to play?" class="sheet-title" />
            <!-- Every card is built by MainMenuController from the activity catalog (coordinator/activities.json): golf,
                 the studio, bowling and every movement in the exercise library, the same card at the same size. None is
                 authored here, so none can drift from the catalog or be weighted above another. -->
            <ui:VisualElement name="cards" class="activities gallery-grid" />
            <ui:VisualElement name="pager" class="gallery-pager" />
            <ui:VisualElement class="selection-row" picking-mode="Ignore">
                <ui:VisualElement class="selection-dot" picking-mode="Ignore" />
                <ui:Label name="selection-caption" text="" class="selection-caption" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
