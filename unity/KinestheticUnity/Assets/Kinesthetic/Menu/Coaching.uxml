<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kinesthetic.UI">
    <ui:Style src="../Palette.uss" />
    <ui:Style src="MainMenu.uss" />
    <!-- Coaching, standing directly to the left of the board: the prescription itself, and the readings that
         say whether it is working. The board answers "what do I do today"; this answers "what am I on, and is
         it moving" — the question a patient takes to their therapist.

         Tiles, like the board, because a pane is the same kind of surface: a transparent world-space panel of
         exactly the board's 1600x900 (Editor/MainMenuSetup.Pane), with the plaza behind it. It was one sand
         sheet divided by hairlines, written when panes were thought to have nothing behind them, and three
         columns of captions on it made it a document you had to read.

         Arranged for what it carries, not copied from next door — the board is two columns with a hero and a
         CTA; this is three bands:
           1. the reading, wide, beside the three figures that qualify it,
           2. a short band of three: where this is going, how many reps land, and the way to a person,
           3. everything prescribed, full width, because a row of it is a sentence and not a card.
         Figures over prose: one number or one chart per tile, and the only sentence left is the clinician's
         own note, once, under what they asked for. -->
    <ui:VisualElement name="coaching-pane" class="menu-screen">
        <ui:VisualElement class="menu-content">

            <ui:VisualElement class="splash-row">
                <ui:VisualElement class="splash-copy">
                    <ui:Label text="Your rehab plan" class="splash-greeting" />
                    <!-- Whose plan this is, stated rather than implied: a demo plan that reads as a real one
                         is the mistake this surface cannot make, so the version and the badge are read first. -->
                    <ui:Label name="plan-provenance" text="" class="splash-sub" />
                </ui:VisualElement>
                <ui:VisualElement class="splash-side">
                    <ui:VisualElement class="plan-source-slot">
                        <k:KTag name="plan-source" text="" tone="Info" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="plan-bento">

                <!-- Band 1: the reading, and the three figures that say what it is being read against. -->
                <ui:VisualElement class="plan-row plan-row-tall">

                    <ui:VisualElement class="tile tile-trend">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="HOW FAR YOU REACH" class="tile-label" />
                            <ui:Label name="trend-note" text="" class="tile-note" />
                        </ui:VisualElement>
                        <ui:VisualElement class="trend-body" picking-mode="Ignore">
                            <ui:VisualElement class="trend-readout" picking-mode="Ignore">
                                <ui:Label name="trend-delta" text="" class="reach-delta" />
                                <ui:Label name="trend-now" text="—" class="stat-number" />
                                <ui:Label name="trend-target" text="" class="reach-best" />
                            </ui:VisualElement>
                            <ui:VisualElement class="trend-plot" picking-mode="Ignore">
                                <ui:VisualElement name="plan-trend" class="plan-trend" picking-mode="Ignore" />
                                <!-- One label per session, from the history's own labels. Without them the
                                     line is a shape going up and to the right; with them it is six sessions. -->
                                <ui:VisualElement name="trend-axis" class="trend-axis" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Stacked rather than side by side: this column is a third of the panel, and three
                         figures across it would each be a number nobody can read from two metres. -->
                    <ui:VisualElement class="tile tile-figures last">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="YOUR PROGRESSION" class="tile-label" />
                            <ui:Label name="envelope-note" text="" class="tile-note" />
                        </ui:VisualElement>
                        <ui:VisualElement class="figure-row first" picking-mode="Ignore">
                            <ui:Label name="level-number" text="—" class="ring-number figure-number" />
                            <ui:VisualElement class="figure-copy" picking-mode="Ignore">
                                <ui:Label text="LEVEL" class="tile-label" />
                                <ui:Label name="level-caption" text="" class="task-detail" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="figure-row" picking-mode="Ignore">
                            <ui:Label name="band-number" text="—" class="ring-number figure-number" />
                            <ui:VisualElement class="figure-copy" picking-mode="Ignore">
                                <ui:Label text="REPS IN BAND" class="tile-label" />
                                <ui:Label name="band-caption" text="" class="task-detail" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="figure-row" picking-mode="Ignore">
                            <ui:Label name="week-number" text="—" class="ring-number figure-number" />
                            <ui:VisualElement class="figure-copy" picking-mode="Ignore">
                                <ui:Label text="WEEK" class="tile-label" />
                                <ui:Label name="week-caption" text="" class="task-detail" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="envelope-ladder" class="envelope-ladder" picking-mode="Ignore" />
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- Band 2: why, how much, and who. Three short tiles, so none of them can grow into prose. -->
                <ui:VisualElement class="plan-row plan-row-short">

                    <ui:VisualElement class="tile tile-goal">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="WORKING TOWARD" class="tile-label" />
                        </ui:VisualElement>
                        <ui:Label name="goal-copy" text="" class="plan-goal" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="tile tile-dose">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="REPS THAT COUNTED" class="tile-label" />
                            <ui:Label name="dose-note" text="" class="tile-note" />
                        </ui:VisualElement>
                        <ui:VisualElement name="dose-bars" class="dose-bars" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <!-- The one thing a patient might want to DO about what they have just read, so it takes
                         the primary treatment and stands in the band rather than under it. -->
                    <ui:Button name="visit-therapist" class="cta cta-visit last">
                        <ui:VisualElement class="cta-copy" picking-mode="Ignore">
                            <ui:Label text="Visit your therapist" class="cta-title" picking-mode="Ignore" />
                            <ui:Label name="visit-sub" text="" class="cta-sub" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="›" class="cta-arrow" picking-mode="Ignore" />
                    </ui:Button>

                </ui:VisualElement>

                <!-- Band 3: full width, because a prescription row is the movement, its dose and where it is
                     done — a line to read across, not a card to read down. -->
                <ui:VisualElement class="tile tile-prescription">
                    <ui:VisualElement class="tile-head" picking-mode="Ignore">
                        <ui:Label text="PRESCRIBED" class="tile-label" />
                        <ui:Label name="prescription-note" text="" class="tile-note accent" />
                    </ui:VisualElement>
                    <!-- A scroller so a clinician who prescribes five things does not push the chart off the
                         panel. With the two or three a plan usually carries it never scrolls. -->
                    <ui:ScrollView name="prescription-list" class="prescription-list"
                                   horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" />
                    <ui:Label name="coaching-note" text="" class="task-detail coaching-note" picking-mode="Ignore" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
