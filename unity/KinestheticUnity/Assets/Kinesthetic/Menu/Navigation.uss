.navigation-root { flex-grow: 1; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); color: #426b80; }
Label { margin: 0; padding: 0; }
Button { border-width: 2px; border-bottom-width: 4px; border-color: #a9d9ee; border-radius: 22px; padding: 8px 22px; margin: 0; font-size: 16px; color: #3289b6; background-color: white; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); -unity-font-style: normal; }
Button:hover, Button:focus { border-color: #2ba6db; background-color: #edfaff; }
Button:active { background-color: #d4effb; }
Button:disabled { opacity: .5; }
Button.return-menu { position: absolute; bottom: 10px; left: 32px; font-size: 13px; padding: 5px 19px; height: 35px; }
.return-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(28,64,90,.3); align-items: center; justify-content: center; }
.return-card { width: 540px; padding: 34px; border-width: 3px; border-bottom-width: 7px; border-color: #bce2f3; border-radius: 25px; background-color: white; }
.return-title { font-size: 29px; color: #288dbd; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.return-detail { font-size: 17px; white-space: normal; margin-top: 14px; margin-bottom: 28px; }
.return-actions { flex-direction: row; justify-content: flex-end; }
Button.primary { color: white; background-color: #35a8d6; border-color: #2493c4; margin-left: 14px; }
Button.primary:hover, Button.primary:focus { background-color: #218fc1; border-color: #146487; }
.transition { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #f1faff; align-items: center; justify-content: center; }
.transition-brand { font-size: 52px; color: #2b9ed0; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.loading-label { font-size: 20px; color: #63899d; margin-top: 18px; }
.hidden { display: none; }
