.navigation-root { flex-grow: 1; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); color: #33456A; }
Label { margin: 0; padding: 0; }
Button { border-width: 2px; border-bottom-width: 4px; border-color: #9FC8E0; border-radius: 22px; padding: 8px 22px; margin: 0; font-size: 16px; color: #0E1C36; background-color: #FDFBF6; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); -unity-font-style: normal; }
Button:hover, Button:focus { border-color: #5C9EC6; background-color: #EAF3F9; }
Button:active { background-color: #CFE4F0; }
Button:disabled { opacity: .5; }
Button.return-menu { position: absolute; bottom: 10px; left: 32px; font-size: 13px; padding: 5px 19px; height: 35px; }
.return-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(14,28,54,.45); align-items: center; justify-content: center; }
.return-card { width: 540px; padding: 34px; border-width: 3px; border-bottom-width: 7px; border-color: #9FC8E0; border-radius: 25px; background-color: #FDFBF6; }
.return-title { font-size: 29px; color: #0E1C36; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.return-detail { font-size: 17px; white-space: normal; margin-top: 14px; margin-bottom: 28px; }
.return-actions { flex-direction: row; justify-content: flex-end; }
Button.primary { color: #FDFBF6; background-color: #2274A5; border-color: #185A83; margin-left: 14px; }
Button.primary:hover, Button.primary:focus { background-color: #185A83; border-color: #124563; }
.transition { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #F2EBDA; align-items: center; justify-content: center; }
.transition-brand { font-size: 52px; color: #0E1C36; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.loading-label { font-size: 20px; color: #6B7EA4; margin-top: 18px; }
Button.activity-help { position: absolute; bottom: 10px; right: 32px; font-size: 13px; padding: 5px 19px; height: 35px; }
.activity-help-card { width: 650px; max-width: 90%; padding: 32px 38px; border-width: 3px; border-bottom-width: 7px; border-color: #9FC8E0; border-radius: 25px; background-color: #FDFBF6; }
.help-eyebrow { font-size: 11px; letter-spacing: 2px; color: #6B7EA4; margin-bottom: 10px; }
.help-step { flex-direction: row; margin-top: 24px; }
.help-number { width: 36px; height: 36px; border-radius: 18px; background-color: #CFE4F0; color: #0E1C36; font-size: 20px; -unity-text-align: middle-center; flex-shrink: 0; margin-right: 16px; }
.help-step-copy { flex-grow: 1; flex-shrink: 1; }
.help-step-title { font-size: 19px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.help-copy { font-size: 15px; white-space: normal; margin-top: 6px; color: #6B7EA4; }
.help-bottom { flex-direction: row; justify-content: space-between; margin-top: 30px; }
.help-bottom Button { font-size: 14px; }
.hidden { display: none; }
