/* Bento board for the menu. Read at roughly two metres off a 1.85 m panel, so every size here is
   larger than a desktop equivalent would be: the smallest type is 16px on a 1600px reference, and
   nothing load-bearing is below 20px. Tiles are translucent white so the plaza stays visible
   through them — the board is a thing standing in the world, not a screen pasted over it. */

.menu-screen { flex-grow: 1; color: #3d657a; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); }
Label { margin: 0; padding: 0; }
.menu-content { flex-grow: 1; padding: 38px 48px 34px; }

/* ---------------------------------------------------------------- splash */

.splash-row { flex-direction: row; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
.splash-copy { flex-grow: 1; flex-shrink: 1; }
.splash-greeting { font-size: 58px; color: #1c6f9c; letter-spacing: -1px; text-shadow: 0 2px 12px rgba(255,255,255,.95); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.splash-sub { font-size: 25px; color: #4d7285; margin-top: 6px; text-shadow: 0 1px 8px rgba(255,255,255,.95); }
.utility-cluster { flex-direction: row; flex-shrink: 0; margin-top: 8px; }

Button { -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); -unity-font-style: normal; color: #3386b6; border-color: rgba(255,255,255,.8); border-width: 2px; border-radius: 22px; background-color: rgba(255,255,255,.88); padding: 10px 22px; margin: 0; }
Button:hover { background-color: rgba(240,251,255,.95); border-color: #53b7e4; }
Button:focus { border-color: #159dd8; }
Button:active { background-color: rgba(217,243,255,.96); }
Button:disabled { opacity: .55; }
.utility-button { font-size: 18px; margin-left: 12px; }

/* ---------------------------------------------------------------- bento grid */

.bento { flex-direction: row; flex-grow: 1; min-height: 0; }
.bento-main { flex-grow: 1.55; flex-basis: 0; min-width: 0; margin-right: 22px; }
.bento-side { flex-grow: 1; flex-basis: 0; min-width: 0; }

.tile { background-color: rgba(255,255,255,.90); border-radius: 24px; border-width: 2px; border-bottom-width: 5px; border-color: rgba(255,255,255,.8); border-bottom-color: rgba(120,170,195,.42); padding: 16px 22px; margin-bottom: 13px; overflow: hidden; }
.tile-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.tile-label { font-size: 17px; letter-spacing: 1.6px; color: #6b93a6; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.tile-note { font-size: 17px; color: #7c9bab; }
.tile-note.accent { color: #1b8ec4; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }

/* ---------------------------------------------------------------- hero */

.tile-hero { flex-grow: 1; min-height: 0; }
.hero-body { flex-direction: row; align-items: center; flex-grow: 1; min-height: 0; }
.hero-readout { flex-shrink: 0; width: 210px; margin-right: 20px; }
.stat-number { font-size: 66px; color: #1b8ec4; letter-spacing: -2px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.stat-caption { font-size: 16px; color: #7c9bab; margin-top: 2px; }
.reach-delta { font-size: 20px; color: #1b8ec4; margin-top: 12px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.reach-best { font-size: 16px; color: #7c9bab; margin-top: 4px; }
.hero-chart { flex-grow: 1; flex-shrink: 1; min-width: 0; height: 186px; }
.goal-copy { font-size: 15px; color: #6b8fa1; white-space: normal; margin-top: 6px; -unity-text-align: middle-center; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); }

/* ---------------------------------------------------------------- consistency */

.tile-calendar { flex-shrink: 0; }
.calendar-days { flex-direction: row; max-width: 420px; align-self: center; width: 100%; margin-bottom: 6px; }
.day-letter { flex-grow: 1; flex-basis: 0; font-size: 14px; color: #93aebb; -unity-text-align: middle-center; }
.calendar-grid { height: 168px; max-width: 420px; align-self: center; width: 100%; }

/* ---------------------------------------------------------------- primary CTA */

.cta { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 20px 28px; border-radius: 26px; border-width: 2px; border-bottom-width: 7px; border-color: #35a9dd; border-bottom-color: #1173a4; background-color: rgba(31,150,205,.95); transition-duration: .16s; }
.cta:hover, .cta:focus { background-color: rgba(26,163,222,.98); border-color: #7fd4f5; scale: 1.02; }
.cta:active { background-color: rgba(16,124,175,.98); scale: 1.005; }
.cta-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.cta-title { font-size: 32px; color: #ffffff; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.cta-sub { font-size: 20px; color: rgba(255,255,255,.88); margin-top: 3px; }
.cta-arrow { font-size: 44px; color: rgba(255,255,255,.92); margin-left: 16px; flex-shrink: 0; }

/* ---------------------------------------------------------------- side tiles */

.tile-ring { flex-shrink: 0; align-items: center; }
.ring-wrap { width: 100%; height: 142px; align-items: center; justify-content: center; margin-top: 4px; }
.program-ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ring-centre { align-items: center; max-width: 100px; }
.ring-number { font-size: 44px; color: #1b8ec4; letter-spacing: -2px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.ring-note { font-size: 16px; color: #7c9bab; margin-top: 6px; }

.tile-streak { flex-shrink: 0; }
.streak-row { flex-direction: row; align-items: center; }
.streak-number { font-size: 58px; color: #f08a3c; letter-spacing: -3px; margin-right: 18px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.streak-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }

.tile-today { flex-grow: 1; min-height: 0; }
.task-row { flex-direction: row; align-items: center; padding: 10px 0; border-top-width: 1px; border-top-color: rgba(154,196,214,.32); }
.task-row.first { border-top-width: 0; }
.task-dot { width: 15px; height: 15px; border-radius: 8px; border-width: 3px; border-color: #63b6da; background-color: rgba(255,255,255,.7); margin-right: 13px; flex-shrink: 0; }
.task-dot.done { background-color: #2ba05f; border-color: #2ba05f; }
.task-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.task-title { font-size: 23px; color: #2b6b88; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.task-detail { font-size: 16px; color: #6e8c9b; margin-top: 1px; }
.task-status { font-size: 15px; color: #5f92a8; padding: 4px 12px; border-radius: 11px; background-color: rgba(226,243,251,.92); flex-shrink: 0; }
.task-status.done { color: #24794a; background-color: rgba(219,245,229,.95); }
#today-empty { font-size: 17px; color: #7593a3; padding: 8px 0; }

.tile-action { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; background-color: rgba(255,255,255,.82); margin-bottom: 0; transition-duration: .16s; }
.tile-action:hover, .tile-action:focus { background-color: rgba(255,255,255,.95); border-color: rgba(57,175,224,.95); scale: 1.02; }
.action-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.action-title { font-size: 29px; color: #2b6b88; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.action-sub { font-size: 18px; color: #6e8c9b; margin-top: 3px; white-space: normal; }
.browse-glyph { width: 40px; height: 40px; flex-shrink: 0; margin-left: 14px; }

/* ---------------------------------------------------------------- overlays */

.modal-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(28,71,92,.38); }
.sheet { width: 1180px; padding: 40px 44px 36px; background-color: rgba(255,255,255,.97); border-radius: 32px; border-width: 3px; border-bottom-width: 8px; border-color: #bce2f3; }
.help-sheet { width: 900px; }
.sheet-title { font-size: 36px; color: #1c7bab; margin-bottom: 22px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-close { align-self: flex-end; margin-top: 26px; font-size: 19px; }
.name-sheet { width: 720px; }
.name-field { margin: 18px 0 14px; }
.name-field > TextInput { font-size: 30px; padding: 14px 18px; border-radius: 18px; border-width: 2px; border-color: #bce2f3; background-color: #f8fdff; color: #1c6f9c; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-actions { flex-direction: row; justify-content: flex-end; margin-top: 22px; }
.sheet-close { margin-left: 14px; font-size: 19px; }
.sheet-close.primary { color: #ffffff; background-color: rgba(31,150,205,.96); border-color: #35a9dd; }
.sheet-close.primary:hover { background-color: rgba(26,163,222,.98); }


.activities { flex-direction: row; }
Button.activity-card { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: stretch; justify-content: flex-start; padding: 18px 22px 10px; border-radius: 26px; border-width: 2px; border-bottom-width: 6px; border-color: #d4e6ed; border-bottom-color: rgba(120,170,195,.55); background-color: #ffffff; overflow: hidden; transition-duration: .16s; }
Button.golf-card { margin-right: 26px; }
Button.activity-card.selected, Button.activity-card:hover, Button.activity-card:focus { border-color: #39afe0; border-bottom-color: #1d8dc6; background-color: #f7fcff; scale: 1.02; }
Button.activity-card:active { border-color: #1688be; background-color: #eaf8ff; scale: 1.005; }
.preview-tag { align-self: flex-start; padding: 6px 14px; border-radius: 12px; color: #2c6d83; font-size: 13px; letter-spacing: 1.2px; background-color: #e9f7fd; }
.card-info { flex-direction: row; align-items: center; padding: 14px 2px 10px; }
.mode-icon { width: 62px; height: 62px; flex-shrink: 0; border-radius: 31px; border-width: 2px; border-color: #c8e9f6; background-color: #f1faff; margin-right: 16px; }
.card-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.card-title { font-size: 30px; color: #319acb; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.card-description { font-size: 16px; color: #6e8c9b; margin-top: 3px; white-space: normal; }
.card-arrow { font-size: 38px; color: #acd4e5; margin-left: 10px; flex-shrink: 0; }
.selected .card-arrow { color: #239fd8; }
.selection-row { height: 54px; flex-direction: row; align-items: center; justify-content: center; }
.selection-dot { width: 9px; height: 9px; border-radius: 5px; background-color: #48b2dd; margin-right: 12px; }
.selection-caption { font-size: 19px; color: #416e88; }

.help-heading { font-size: 21px; margin-top: 22px; margin-bottom: 6px; color: #2b6b88; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.help-copy { font-size: 18px; white-space: normal; color: #5d7e90; }

.hidden { display: none; }

/* ---- Friends -------------------------------------------------------------
   Same cool palette as the activity cards (#268cbe accents, #5d7e90 secondary
   text, 12-28px radii). No red and no counts of missed days: this surface has
   to feel welcoming on the days someone has not shown up. */

.utility-left { flex-direction: row; align-items: center; }

.friends-button {
    flex-direction: row;
    align-items: center;
    height: 36px;
    padding: 0 14px 0 8px;
    margin-right: 18px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(38, 140, 190, 0.22);
    background-color: rgba(255, 255, 255, 0.72);
    transition-property: background-color, border-color;
    transition-duration: 0.14s;
}
.friends-button:hover { background-color: rgb(255, 255, 255); border-color: rgba(38, 140, 190, 0.45); }
.friends-button:focus { border-color: #319acb; }
.friends-faces { flex-direction: row; align-items: center; height: 26px; margin-right: 8px; }
.friends-label { font-size: 14px; color: #3d657a; -unity-font-style: bold; }

/* A gentle count of who is waiting, never a red alert. */
.friends-badge {
    margin-left: 8px;
    min-width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: #53b7e4;
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.friends-badge.hidden { display: none; }

/* Stacked Mii faces, overlapping like an avatar group. */
.friend-face {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-right: -8px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.friends-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(17, 47, 63, 0.34);
}
.friends-overlay.hidden { display: none; }

.friends-panel {
    width: 860px;
    height: 560px;
    border-radius: 28px;
    background-color: rgb(255, 255, 255);
    padding: 26px 28px 24px;
}
.friends-header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.friends-heading { flex-direction: column; }
.friends-title { font-size: 26px; color: #2b566b; -unity-font-style: bold; }
.friends-subtitle { font-size: 13px; color: #7895a5; margin-top: 2px; }
.panel-close { min-width: 92px; font-size: 13px; }

.friends-body { flex-direction: row; flex-grow: 1; margin-top: 18px; }

.friends-list-pane { width: 268px; margin-right: 22px; }
.friends-list { flex-grow: 1; }

.friend-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 9px 10px;
    margin-bottom: 6px;
    border-radius: 14px;
    background-color: rgba(236, 245, 250, 0.7);
}
.friend-row:hover { background-color: rgb(228, 241, 248); }
.friend-row.selected { background-color: rgba(38, 140, 190, 0.14); }
.friend-row-face { width: 34px; height: 34px; border-radius: 17px; margin-right: 10px; }
.friend-row-copy { flex-grow: 1; flex-shrink: 1; flex-direction: column; overflow: hidden; margin-right: 8px; }
.friend-row-name { font-size: 14px; color: #3d657a; -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.friend-row-meta { font-size: 11px; color: #8397a2; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; }
.friend-row-dot { width: 8px; height: 8px; border-radius: 4px; background-color: #53b7e4; margin-left: 6px; }
.friend-row-dot.hidden { display: none; }

.follow-pill {
    flex-shrink: 0;
    min-width: 76px;
    height: 26px;
    font-size: 11px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(38, 140, 190, 0.35);
    background-color: rgba(255, 255, 255, 0.9);
    color: #3386b6;
}
.follow-pill.following { background-color: #268cbe; color: rgb(255, 255, 255); border-color: #268cbe; }

.invite-block { margin-top: 12px; }
.ghost-button {
    height: 32px;
    font-size: 12px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(38, 140, 190, 0.3);
    background-color: rgba(255, 255, 255, 0.9);
    color: #3386b6;
}
.invite-code {
    font-size: 20px;
    color: #268cbe;
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-top: 8px;
}
.invite-code.hidden { display: none; }
.code-row { flex-direction: row; align-items: center; margin-top: 8px; }
.code-field { flex-grow: 1; margin-right: 6px; height: 32px; font-size: 13px; }
.friends-notice { font-size: 11px; color: #8397a2; margin-top: 6px; white-space: normal; }

.thread-pane { flex-grow: 1; flex-direction: column; }
.thread-head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.thread-face { width: 30px; height: 30px; border-radius: 15px; margin-right: 10px; }
.thread-name { font-size: 17px; color: #3d657a; -unity-font-style: bold; }
.thread { flex-grow: 1; border-radius: 18px; background-color: rgba(236, 245, 250, 0.55); padding: 12px; }

/* Messages read as speech, so they are asymmetric: mine tinted, theirs white. */
.bubble { max-width: 74%; border-radius: 16px; padding: 9px 13px; margin-bottom: 8px; }
.bubble-mine { align-self: flex-end; background-color: #268cbe; }
.bubble-theirs { align-self: flex-start; background-color: rgb(255, 255, 255); }
.bubble-text { font-size: 13px; white-space: normal; }
.bubble-mine .bubble-text { color: rgb(255, 255, 255); }
.bubble-theirs .bubble-text { color: #3d657a; }
.bubble-kind { font-size: 13px; -unity-font-style: bold; }
.bubble-mine .bubble-kind { color: rgb(255, 255, 255); }
.bubble-theirs .bubble-kind { color: #268cbe; }
.bubble-photo { width: 190px; height: 128px; border-radius: 12px; margin-top: 6px; }
.bubble-time { font-size: 10px; margin-top: 3px; }
.bubble-mine .bubble-time { color: rgba(255, 255, 255, 0.72); }
.bubble-theirs .bubble-time { color: #a8bcc6; }

.thread-empty { font-size: 13px; color: #8397a2; -unity-text-align: middle-center; margin-top: 30px; white-space: normal; }

/* One tap is the whole message. Most encouragement should cost nothing. */
.quick-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.quick-chip {
    height: 30px;
    padding: 0 14px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 15px;
    border-width: 1px;
    border-color: rgba(38, 140, 190, 0.28);
    background-color: rgba(255, 255, 255, 0.95);
    color: #3386b6;
    font-size: 12px;
}
.quick-chip:hover { background-color: rgb(226, 241, 249); border-color: #53b7e4; }

.composer { flex-direction: row; align-items: center; margin-top: 8px; }
.composer-text { flex-grow: 1; height: 36px; font-size: 13px; margin-right: 6px; }
.send-button {
    min-width: 84px;
    height: 36px;
    margin-left: 6px;
    border-radius: 18px;
    background-color: #268cbe;
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 0;
}
.send-button:hover { background-color: #319acb; }


/* ---- Spotlight: one friend, on the landing page ---------------------------
   Shows a message a friend actually sent. When there is none it states the
   friendship rather than inventing a quote — putting words in a real person's
   mouth would be a betrayal of someone at a low point. */
.friend-spotlight {
    position: absolute;
    right: 46px;
    bottom: 38px;
    flex-direction: row;
    align-items: center;
    max-width: 420px;
    padding: 12px 16px 12px 12px;
    border-radius: 26px;
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 1px;
    border-color: rgba(38, 140, 190, 0.18);
}
.friend-spotlight.hidden { display: none; }
.spotlight-face { width: 52px; height: 52px; border-radius: 26px; margin-right: 12px; flex-shrink: 0; }
.spotlight-copy { flex-direction: column; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.spotlight-name { font-size: 13px; color: #268cbe; -unity-font-style: bold; }
.spotlight-line { font-size: 14px; color: #3d657a; white-space: normal; margin-top: 1px; }
.spotlight-reply {
    flex-shrink: 0;
    height: 30px;
    margin-left: 12px;
    padding: 0 14px;
    border-radius: 15px;
    border-width: 1px;
    border-color: rgba(38, 140, 190, 0.3);
    background-color: rgba(255, 255, 255, 0.95);
    color: #3386b6;
    font-size: 12px;
}
.spotlight-reply:hover { background-color: rgb(226, 241, 249); border-color: #53b7e4; }

.thread-hint { font-size: 12px; color: #8397a2; margin-left: 10px; }

/* A per-row Message button, so sending is never hidden behind selection. */
.message-pill {
    flex-shrink: 0;
    min-width: 74px;
    height: 26px;
    margin-left: 6px;
    font-size: 11px;
    border-radius: 13px;
    border-width: 0;
    background-color: rgba(38, 140, 190, 0.12);
    color: #268cbe;
}
.message-pill:hover { background-color: rgba(38, 140, 190, 0.22); }
