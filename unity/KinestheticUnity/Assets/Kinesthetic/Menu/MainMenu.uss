/* Bento board for the menu. Read at roughly two metres off a 1.85 m panel, so every size here is
   larger than a desktop equivalent would be: the smallest type is 16px on a 1600px reference, and
   nothing load-bearing is below 20px. Tiles are translucent sand so the plaza stays visible
   through them — the board is a thing standing in the world, not a screen pasted over it.

   Colours are the five in Assets/Kinesthetic/Palette.cs and nothing else: indigo ink on sand panels,
   glaucous for anything read second, ice for selection and focus, and coral for exactly two things —
   the start button and the streak. The start button is lettered in indigo, not white, because white
   on coral reads at 2.1:1. */

.menu-screen { flex-grow: 1; color: var(--slate-70); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); }
Label { margin: 0; padding: 0; }
.menu-content { flex-grow: 1; padding: 38px 48px 34px; }

/* ---------------------------------------------------------------- splash */

.splash-row { flex-direction: row; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
.splash-copy { flex-grow: 1; flex-shrink: 1; }
.splash-greeting { font-size: 58px; color: var(--prussian-50); letter-spacing: -1px; text-shadow: 0 2px 12px var(--sand-00-a95); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.splash-sub { font-size: 25px; color: var(--slate-70); margin-top: 6px; text-shadow: 0 1px 8px var(--sand-00-a95); }
.splash-side { flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: 24px; }
.utility-cluster { flex-direction: row; flex-shrink: 0; margin-top: 8px; }

Button { -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); -unity-font-style: normal; color: var(--prussian-50); border-color: var(--sand-00-a80); border-width: 2px; border-radius: 22px; background-color: var(--sand-00-a88); padding: 10px 22px; margin: 0; }
Button:hover { background-color: var(--cerulean-10-a95); border-color: var(--cerulean-40); }
Button:focus { border-color: var(--cerulean-50); }
Button:active { background-color: var(--cerulean-20-a96); }
Button:disabled { opacity: .55; }
.utility-button { font-size: 18px; margin-left: 12px; }

/* ---------------------------------------------------------------- bento grid */

.bento { flex-direction: row; flex-grow: 1; min-height: 0; }
.bento-main { flex-grow: 1.55; flex-basis: 0; min-width: 0; margin-right: 22px; }
.bento-side { flex-grow: 1; flex-basis: 0; min-width: 0; }

.tile { background-color: var(--sand-00-a90); border-radius: 24px; border-width: 2px; border-bottom-width: 5px; border-color: var(--sand-00-a80); border-bottom-color: var(--slate-50-a42); padding: 16px 22px; margin-bottom: 13px; overflow: hidden; }
.tile-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.tile-label { font-size: 17px; letter-spacing: 1.6px; color: var(--slate-60); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.tile-note { font-size: 17px; color: var(--slate-50); }
.tile-note.accent { color: var(--cerulean-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }

/* ---------------------------------------------------------------- hero */

.tile-hero { flex-grow: 1; min-height: 0; }
.hero-body { flex-direction: row; align-items: stretch; flex-grow: 1; min-height: 0; }
.hero-readout { flex-shrink: 0; width: 214px; margin-right: 12px; justify-content: center; }
.reach-delta { font-size: 23px; color: var(--jungle-60); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.stat-number { font-size: 78px; color: var(--prussian-50); letter-spacing: -3px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.stat-caption { font-size: 16px; color: var(--slate-50); margin-top: 2px; -unity-text-align: middle-center; }
.reach-best { font-size: 16px; color: var(--slate-50); margin-top: 2px; }
.reach-cheer { font-size: 17px; color: var(--jungle-60); margin-top: 10px; white-space: normal; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.range-fan { flex-grow: 1; flex-shrink: 1; min-width: 0; }

/* ---------------------------------------------------------------- consistency */

.tile-calendar { flex-shrink: 0; }
.calendar-days { flex-direction: row; max-width: 380px; align-self: center; width: 100%; margin-bottom: 6px; }
.day-letter { flex-grow: 1; flex-basis: 0; font-size: 14px; color: var(--slate-40); -unity-text-align: middle-center; }
.calendar-grid { height: 140px; max-width: 380px; align-self: center; width: 100%; }

/* ---------------------------------------------------------------- primary CTA */

.cta { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 20px 28px; border-radius: 26px; border-width: 2px; border-bottom-width: 7px; border-color: var(--cerulean-40); border-bottom-color: var(--cerulean-70); background-color: var(--cerulean-50-a95); transition-duration: .16s; }
.cta:hover, .cta:focus { background-color: var(--cerulean-45-a98); border-color: var(--cerulean-30); scale: 1.02; }
.cta:active { background-color: var(--cerulean-60-a98); scale: 1.005; }
.cta-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.cta-title { font-size: 32px; color: var(--sand-00); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.cta-sub { font-size: 20px; color: var(--sand-00-a88); margin-top: 3px; }
.cta-arrow { font-size: 44px; color: var(--sand-00-a92); margin-left: 16px; flex-shrink: 0; }

/* ---------------------------------------------------------------- side tiles */

.tile-progress { flex-shrink: 0; padding-top: 14px; padding-bottom: 16px; }
.progress-split { flex-direction: row; align-items: center; justify-content: center; margin: 4px 0 2px; }
.progress-cell { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: center; }
.goal-cell { flex-grow: 1.5; padding: 0 8px; }
.progress-rule { width: 1px; height: 100px; background-color: var(--slate-30-a55); margin: 0 14px; }
.ring-wrap { width: 126px; height: 126px; flex-shrink: 0; align-items: center; justify-content: center; }
.program-ring { position: absolute; width: 126px; height: 126px; }
.ring-centre { align-items: center; max-width: 92px; }
.ring-number { font-size: 44px; color: var(--prussian-50); letter-spacing: -1px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.ring-caption { font-size: 15px; color: var(--slate-50); -unity-text-align: middle-center; }
.streak-number { font-size: 58px; color: var(--jungle-40); letter-spacing: -3px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.goal-copy { font-size: 17px; color: var(--slate-70); white-space: normal; margin-top: 8px; -unity-text-align: middle-center; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); }

.tile-today { flex-grow: 1; min-height: 0; }
.task-row { flex-direction: row; align-items: center; padding: 10px 0; border-top-width: 1px; border-top-color: var(--slate-50-a28); }
.task-row.first { border-top-width: 0; }
.task-dot { width: 15px; height: 15px; border-radius: 8px; border-width: 3px; border-color: var(--slate-50); background-color: var(--sand-00-a70); margin-right: 13px; flex-shrink: 0; }
.task-dot.done { background-color: var(--jungle-40); border-color: var(--jungle-40); }
.task-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.task-title { font-size: 23px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.task-detail { font-size: 16px; color: var(--slate-50); margin-top: 1px; }
.task-status { font-size: 15px; color: var(--slate-60); padding: 4px 12px; border-radius: 11px; background-color: var(--cerulean-20-a85); flex-shrink: 0; }
.task-status.done { color: var(--jungle-60); background-color: var(--jungle-20-a75); }
#today-empty { font-size: 17px; color: var(--slate-50); padding: 8px 0; }

.tile-action { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; background-color: var(--sand-00-a82); margin-bottom: 0; transition-duration: .16s; }
.tile-action:hover, .tile-action:focus { background-color: var(--sand-00-a95); border-color: var(--cerulean-40-a95); scale: 1.02; }
.action-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.action-title { font-size: 29px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.action-sub { font-size: 18px; color: var(--slate-50); margin-top: 3px; white-space: normal; }
.browse-glyph { width: 40px; height: 40px; flex-shrink: 0; margin-left: 14px; }

/* ---------------------------------------------------------------- overlays */

.modal-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: var(--prussian-70-a45); }
.sheet { width: 1180px; padding: 40px 44px 36px; background-color: var(--sand-00-a97); border-radius: 32px; border-width: 3px; border-bottom-width: 8px; border-color: var(--cerulean-30); }
.help-sheet { width: 900px; }
.sheet-title { font-size: 36px; color: var(--prussian-50); margin-bottom: 22px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-close { align-self: flex-end; margin-top: 26px; font-size: 19px; }
.name-sheet { width: 720px; }
.name-field { margin: 18px 0 14px; }
.name-field > TextInput { font-size: 30px; padding: 14px 18px; border-radius: 18px; border-width: 2px; border-color: var(--cerulean-30); background-color: var(--sand-00); color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-actions { flex-direction: row; justify-content: flex-end; margin-top: 22px; }
.sheet-close { margin-left: 14px; font-size: 19px; }
.sheet-close.primary { color: var(--sand-00); background-color: var(--cerulean-50-a96); border-color: var(--cerulean-60); }
.sheet-close.primary:hover { background-color: var(--cerulean-60-a98); }


.activities { flex-direction: row; }
Button.activity-card { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: stretch; justify-content: flex-start; padding: 18px 22px 10px; border-radius: 26px; border-width: 2px; border-bottom-width: 6px; border-color: var(--cerulean-20); border-bottom-color: var(--slate-50-a55); background-color: var(--sand-00); overflow: hidden; transition-duration: .16s; }
Button.golf-card, Button.studio-card { margin-right: 18px; }
Button.activity-card.selected, Button.activity-card:hover, Button.activity-card:focus { border-color: var(--cerulean-50); border-bottom-color: var(--cerulean-60); background-color: var(--cerulean-10); scale: 1.02; }
Button.activity-card:active { border-color: var(--cerulean-60); background-color: var(--cerulean-20); scale: 1.005; }
.preview-tag { align-self: flex-start; padding: 6px 14px; border-radius: 12px; color: var(--slate-70); font-size: 13px; letter-spacing: 1.2px; background-color: var(--cerulean-20); }
.card-info { flex-direction: row; align-items: center; padding: 14px 2px 10px; }
.mode-icon { width: 62px; height: 62px; flex-shrink: 0; border-radius: 31px; border-width: 2px; border-color: var(--cerulean-30); background-color: var(--cerulean-10); margin-right: 16px; }
.card-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.card-title { font-size: 30px; white-space: normal; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.card-description { font-size: 16px; color: var(--slate-50); margin-top: 3px; white-space: normal; }
.card-arrow { font-size: 38px; color: var(--slate-30); margin-left: 10px; flex-shrink: 0; }
.selected .card-arrow { color: var(--cerulean-50); }
.selection-row { height: 54px; flex-direction: row; align-items: center; justify-content: center; }
.selection-dot { width: 9px; height: 9px; border-radius: 5px; background-color: var(--cerulean-50); margin-right: 12px; }
.selection-caption { font-size: 19px; color: var(--slate-60); }

.help-heading { font-size: 21px; margin-top: 22px; margin-bottom: 6px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.help-copy { font-size: 18px; white-space: normal; color: var(--slate-50); }

.hidden { display: none; }
