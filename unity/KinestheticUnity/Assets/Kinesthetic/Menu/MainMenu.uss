/* Bento board for the menu. Read at roughly two metres off a 1.85 m panel, so every size here is
   larger than a desktop equivalent would be: the smallest type is 16px on a 1600px reference, and
   nothing load-bearing is below 20px. Tiles are translucent sand so the plaza stays visible
   through them — the board is a thing standing in the world, not a screen pasted over it.

   Colours are the five in Assets/Kinesthetic/Palette.cs and nothing else: indigo ink on sand panels,
   glaucous for anything read second, ice for selection and focus, and coral for exactly two things —
   the start button and the streak. The start button is lettered in indigo, not white, because white
   on coral reads at 2.1:1. */

.menu-screen { flex-grow: 1; color: var(--slate-70); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); }
Label { margin: 0; padding: 0; }
.menu-content { flex-grow: 1; padding: 38px 48px 34px; }

/* ---------------------------------------------------------------- splash */

.splash-row { flex-direction: row; align-items: flex-start; justify-content: space-between; margin-bottom: 20px; }
.splash-copy { flex-grow: 1; flex-shrink: 1; }
.splash-greeting { font-size: 58px; color: var(--prussian-50); letter-spacing: -1px; text-shadow: 0 2px 12px var(--sand-00-a95); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.splash-sub { font-size: 25px; color: var(--slate-70); margin-top: 6px; text-shadow: 0 1px 8px var(--sand-00-a95); }
.splash-side { flex-direction: column; align-items: flex-end; flex-shrink: 0; margin-left: 24px; }
.utility-cluster { flex-direction: row; flex-shrink: 0; margin-top: 8px; }

Button { -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); -unity-font-style: normal; color: var(--prussian-50); border-color: var(--sand-00-a80); border-width: 2px; border-radius: 22px; background-color: var(--sand-00-a88); padding: 10px 22px; margin: 0; }
Button:hover { background-color: var(--cerulean-10-a95); border-color: var(--cerulean-40); }
Button:focus { border-color: var(--cerulean-50); }
Button:active { background-color: var(--cerulean-20-a96); }
Button:disabled { opacity: .55; }
.utility-button { font-size: 18px; margin-left: 12px; }

/* ---------------------------------------------------------------- bento grid */

.bento { flex-direction: row; flex-grow: 1; min-height: 0; }
.bento-main { flex-grow: 1.55; flex-basis: 0; min-width: 0; margin-right: 22px; }
.bento-side { flex-grow: 1; flex-basis: 0; min-width: 0; }

.tile { background-color: var(--sand-00-a90); border-radius: 24px; border-width: 2px; border-bottom-width: 5px; border-color: var(--sand-00-a80); border-bottom-color: var(--slate-50-a42); padding: 16px 22px; margin-bottom: 13px; overflow: hidden; }
.tile-head { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.tile-label { font-size: 17px; letter-spacing: 1.6px; color: var(--slate-60); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.tile-note { font-size: 17px; color: var(--slate-50); }
.tile-note.accent { color: var(--cerulean-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }

/* ---------------------------------------------------------------- hero */

.tile-hero { flex-grow: 1; min-height: 0; }
.hero-body { flex-direction: row; align-items: stretch; flex-grow: 1; min-height: 0; }
/* Three lines and no more: the number, one line of green above it saying how it has moved, one quiet line
   under it saying where it stands against the target. The cheer that used to follow said the same thing as
   the caption in more words. */
.hero-readout { flex-shrink: 0; width: 214px; margin-right: 12px; justify-content: center; }
.reach-delta { font-size: 21px; color: var(--jungle-60); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.stat-number { font-size: 84px; color: var(--prussian-50); letter-spacing: -3px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.stat-caption { font-size: 16px; color: var(--slate-50); margin-top: 2px; -unity-text-align: middle-center; }
.reach-best { font-size: 17px; color: var(--slate-50); margin-top: 4px; white-space: normal; }
.range-fan { flex-grow: 1; flex-shrink: 1; min-width: 0; }

/* ---------------------------------------------------------------- consistency */

.tile-calendar { flex-shrink: 0; }
.calendar-days { flex-direction: row; max-width: 380px; align-self: center; width: 100%; margin-bottom: 6px; }
.day-letter { flex-grow: 1; flex-basis: 0; font-size: 14px; color: var(--slate-40); -unity-text-align: middle-center; }
.calendar-grid { height: 140px; max-width: 380px; align-self: center; width: 100%; }

/* ---------------------------------------------------------------- primary CTA */

.cta { flex-direction: row; align-items: center; justify-content: space-between; flex-shrink: 0; padding: 20px 28px; border-radius: 26px; border-width: 2px; border-bottom-width: 7px; border-color: var(--cerulean-40); border-bottom-color: var(--cerulean-70); background-color: var(--cerulean-50-a95); transition-duration: .16s; }
.cta:hover, .cta:focus { background-color: var(--cerulean-45-a98); border-color: var(--cerulean-30); scale: 1.02; }
.cta:active { background-color: var(--cerulean-60-a98); scale: 1.005; }
.cta-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.cta-title { font-size: 32px; color: var(--sand-00); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.cta-sub { font-size: 20px; color: var(--sand-00-a88); margin-top: 3px; }
.cta-arrow { font-size: 44px; color: var(--sand-00-a92); margin-left: 16px; flex-shrink: 0; }

/* ---------------------------------------------------------------- side tiles */

.tile-progress { flex-shrink: 0; padding-top: 14px; padding-bottom: 16px; }
.progress-split { flex-direction: row; align-items: center; justify-content: center; margin: 4px 0 2px; }
.progress-cell { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: center; }
.goal-cell { flex-grow: 1.5; padding: 0 8px; }
.progress-rule { width: 1px; height: 100px; background-color: var(--slate-30-a55); margin: 0 14px; }
.ring-wrap { width: 126px; height: 126px; flex-shrink: 0; align-items: center; justify-content: center; }
.program-ring { position: absolute; width: 126px; height: 126px; }
/* Lifted a few pixels: a label's box carries descender room under the digits, so a number and a caption
   centred geometrically sit visibly low in the ring. The nudge puts the pair's optical centre on the ring's. */
.ring-centre { align-items: center; max-width: 92px; translate: 0 -5px; }
.ring-number { font-size: 42px; color: var(--prussian-50); letter-spacing: -1px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.ring-caption { font-size: 14px; color: var(--slate-50); margin-top: -3px; -unity-text-align: middle-center; }
.streak-number { font-size: 58px; color: var(--jungle-40); letter-spacing: -3px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.goal-copy { font-size: 17px; color: var(--slate-70); white-space: normal; margin-top: 8px; -unity-text-align: middle-center; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf"); }

.tile-today { flex-grow: 1; min-height: 0; }
.task-row { flex-direction: row; align-items: center; padding: 10px 0; border-top-width: 1px; border-top-color: var(--slate-50-a28); }
.task-row.first { border-top-width: 0; }
.task-dot { width: 15px; height: 15px; border-radius: 8px; border-width: 3px; border-color: var(--slate-50); background-color: var(--sand-00-a70); margin-right: 13px; flex-shrink: 0; }
.task-dot.done { background-color: var(--jungle-40); border-color: var(--jungle-40); }
.task-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.task-title { font-size: 23px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.task-detail { font-size: 16px; color: var(--slate-50); margin-top: 1px; }
.task-status { font-size: 15px; color: var(--slate-60); padding: 4px 12px; border-radius: 11px; background-color: var(--cerulean-20-a85); flex-shrink: 0; }
.task-status.done { color: var(--jungle-60); background-color: var(--jungle-20-a75); }
#today-empty { font-size: 17px; color: var(--slate-50); padding: 8px 0; }

/* ---------------------------------------------------------------- pane links

   The stack that took the place of the single "Choose activity" tile: one small button for every pane in
   the ring, built by MainMenuController.BuildPaneLinks. They share the tile's footprint, so a taller stack
   makes each one shorter rather than pushing the Today tile up. Each names where it goes and points the way
   the ring will turn to get there. */

.pane-links { flex-shrink: 0; }
.pane-link { flex-direction: row; align-items: center; justify-content: space-between; padding: 11px 22px 11px 24px; margin: 0 0 8px; border-radius: 20px; border-width: 2px; border-bottom-width: 4px; border-color: var(--sand-00-a80); border-bottom-color: var(--slate-50-a42); background-color: var(--sand-00-a82); transition-duration: .16s; }
.pane-link.last { margin-bottom: 0; }
.pane-link:hover, .pane-link:focus { background-color: var(--sand-00-a95); border-color: var(--cerulean-40-a95); border-bottom-color: var(--cerulean-50); scale: 1.02; }
.pane-link:active { background-color: var(--cerulean-10-a95); scale: 1.005; }
.pane-link-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.pane-link-title { font-size: 24px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.pane-link-sub { font-size: 15px; color: var(--slate-50); margin-top: 1px; white-space: normal; }
.pane-link-arrow { font-size: 34px; color: var(--cerulean-50); margin-left: 14px; flex-shrink: 0; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }

/* ---------------------------------------------------------------- overlays */

.modal-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; background-color: var(--prussian-70-a45); }
.sheet { width: 1180px; padding: 40px 44px 36px; background-color: var(--sand-00-a97); border-radius: 32px; border-width: 3px; border-bottom-width: 8px; border-color: var(--cerulean-30); }
.help-sheet { width: 900px; }
.sheet-title { font-size: 36px; color: var(--prussian-50); margin-bottom: 22px; -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-close { align-self: flex-end; margin-top: 26px; font-size: 19px; }
.name-sheet { width: 720px; }
.name-field { margin: 18px 0 14px; }
.name-field > TextInput { font-size: 30px; padding: 14px 18px; border-radius: 18px; border-width: 2px; border-color: var(--cerulean-30); background-color: var(--sand-00); color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.sheet-actions { flex-direction: row; justify-content: flex-end; margin-top: 22px; }
.sheet-close { margin-left: 14px; font-size: 19px; }
.sheet-close.primary { color: var(--sand-00); background-color: var(--cerulean-50-a96); border-color: var(--cerulean-60); }
.sheet-close.primary:hover { background-color: var(--cerulean-60-a98); }


.activities { flex-direction: row; }
Button.activity-card { flex-grow: 1; flex-basis: 0; min-width: 0; align-items: stretch; justify-content: flex-start; padding: 18px 22px 10px; border-radius: 26px; border-width: 2px; border-bottom-width: 6px; border-color: var(--cerulean-20); border-bottom-color: var(--slate-50-a55); background-color: var(--sand-00); overflow: hidden; transition-duration: .16s; }
Button.golf-card, Button.studio-card { margin-right: 18px; }
Button.activity-card.selected, Button.activity-card:hover, Button.activity-card:focus { border-color: var(--cerulean-50); border-bottom-color: var(--cerulean-60); background-color: var(--cerulean-10); scale: 1.02; }
Button.activity-card:active { border-color: var(--cerulean-60); background-color: var(--cerulean-20); scale: 1.005; }
.preview-tag { align-self: flex-start; padding: 6px 14px; border-radius: 12px; color: var(--slate-70); font-size: 13px; letter-spacing: 1.2px; background-color: var(--cerulean-20); }
.card-info { flex-direction: row; align-items: center; padding: 14px 2px 10px; }
.mode-icon { width: 62px; height: 62px; flex-shrink: 0; border-radius: 31px; border-width: 2px; border-color: var(--cerulean-30); background-color: var(--cerulean-10); margin-right: 16px; }
.card-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.card-title { font-size: 30px; white-space: normal; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.card-description { font-size: 16px; color: var(--slate-50); margin-top: 3px; white-space: normal; }
.card-arrow { font-size: 38px; color: var(--slate-30); margin-left: 10px; flex-shrink: 0; }
.selected .card-arrow { color: var(--cerulean-50); }
.selection-row { height: 54px; flex-direction: row; align-items: center; justify-content: center; }
.selection-dot { width: 9px; height: 9px; border-radius: 5px; background-color: var(--cerulean-50); margin-right: 12px; }
.selection-caption { font-size: 19px; color: var(--slate-60); }

.help-heading { font-size: 21px; margin-top: 22px; margin-bottom: 6px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.help-copy { font-size: 18px; white-space: normal; color: var(--slate-50); }

.hidden { display: none; }

/* ---- Friends -------------------------------------------------------------
   Palette.uss tokens throughout, like every other surface: prussian ink, slate
   for anything read second, cerulean for selection and focus. No red and no counts of missed days: this surface has
   to feel welcoming on the days someone has not shown up. */

.friends-button {
    flex-direction: row;
    align-items: center;
    font-size: 18px;
    /* Tighter on the left so the stacked faces sit inside the pill's curve. */
    padding: 10px 22px 10px 14px;
}
.friends-faces { flex-direction: row; align-items: center; height: 26px; margin-right: 16px; }
.friends-label { font-size: 18px; color: var(--prussian-50); }

/* A gentle count of who is waiting, never a red alert. */
.friends-badge {
    margin-left: 8px;
    min-width: 24px;
    height: 24px;
    border-radius: 12px;
    background-color: var(--cerulean-50);
    color: var(--sand-00);
    font-size: 15px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
}
.friends-badge.hidden { display: none; }

/* Stacked Mii faces, overlapping like an avatar group. */
.friend-face {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    margin-right: -8px;
    border-width: 2px;
    border-color: var(--sand-00);
}

.friends-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--prussian-70-a45);
}
.friends-overlay.hidden { display: none; }

.friends-panel {
    width: 980px;
    height: 600px;
    border-radius: 32px;
    border-width: 3px;
    border-bottom-width: 8px;
    border-color: var(--cerulean-30);
    background-color: var(--sand-00-a97);
    padding: 32px 34px 28px;
}
.friends-header { flex-direction: row; justify-content: space-between; align-items: flex-start; }
.friends-heading { flex-direction: column; }
.friends-title { font-size: 32px; color: var(--prussian-50); -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-ExtraBold.ttf"); }
.friends-subtitle { font-size: 16px; color: var(--slate-50); margin-top: 4px; }
.panel-close { font-size: 19px; }

.friends-body { flex-direction: row; flex-grow: 1; margin-top: 18px; }

.friends-list-pane { width: 360px; margin-right: 22px; }
.friends-list { flex-grow: 1; }

.friend-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    padding: 9px 10px;
    margin-bottom: 6px;
    border-radius: 14px;
    background-color: var(--sand-30-a70);
}
.friend-row:hover { background-color: var(--cerulean-20-a96); }
.friend-row.selected { background-color: var(--slate-50-a28); }
.friend-row-face { width: 34px; height: 34px; border-radius: 17px; margin-right: 10px; }
.friend-row-copy { flex-grow: 1; flex-shrink: 1; flex-direction: column; overflow: hidden; margin-right: 8px; }
.friend-row-name { font-size: 17px; color: var(--prussian-50); -unity-font-style: bold; overflow: hidden; text-overflow: ellipsis; }
.friend-row-meta { font-size: 14px; color: var(--slate-50); margin-top: 1px; overflow: hidden; text-overflow: ellipsis; }
.friend-row-dot { width: 8px; height: 8px; border-radius: 4px; background-color: var(--cerulean-50); margin-left: 6px; }
.friend-row-dot.hidden { display: none; }

.follow-pill {
    flex-shrink: 0;
    min-width: 68px;
    height: 26px;
    padding: 0 12px;
    font-size: 14px;
    border-radius: 13px;
    border-width: 1px;
    border-color: var(--slate-50-a42);
    background-color: var(--sand-00-a90);
    color: var(--prussian-50);
}
.follow-pill.following { background-color: var(--prussian-50); color: var(--sand-00); border-color: var(--prussian-50); }

.invite-block { margin-top: 12px; }
.ghost-button {
    height: 32px;
    padding: 0 16px;
    font-size: 15px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--slate-50-a42);
    background-color: var(--sand-00-a90);
    color: var(--prussian-50);
}
.invite-code {
    font-size: 24px;
    color: var(--prussian-50);
    -unity-font-style: bold;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    margin-top: 8px;
}
.invite-code.hidden { display: none; }
.code-row { flex-direction: row; align-items: center; margin-top: 8px; }
.code-field { flex-grow: 1; margin-right: 6px; height: 40px; font-size: 16px; }
.friends-notice { font-size: 14px; color: var(--slate-50); margin-top: 6px; white-space: normal; }

.thread-pane { flex-grow: 1; flex-direction: column; }
.thread-head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.thread-face { width: 30px; height: 30px; border-radius: 15px; margin-right: 10px; }
.thread-name { font-size: 20px; color: var(--prussian-50); -unity-font-style: bold; }
.thread { flex-grow: 1; border-radius: 18px; background-color: var(--sand-30-a70); padding: 12px; }

/* Messages read as speech, so they are asymmetric: mine tinted, theirs white. */
.bubble { max-width: 74%; border-radius: 16px; padding: 9px 13px; margin-bottom: 8px; }
.bubble-mine { align-self: flex-end; background-color: var(--prussian-50); }
.bubble-theirs { align-self: flex-start; background-color: var(--sand-00); }
.bubble-text { font-size: 16px; white-space: normal; }
.bubble-mine .bubble-text { color: var(--sand-00); }
.bubble-theirs .bubble-text { color: var(--prussian-50); }
.bubble-kind { font-size: 16px; -unity-font-style: bold; }
.bubble-mine .bubble-kind { color: var(--sand-00); }
.bubble-theirs .bubble-kind { color: var(--prussian-50); }
.bubble-photo { width: 190px; height: 128px; border-radius: 12px; margin-top: 6px; }
.bubble-time { font-size: 13px; margin-top: 3px; }
.bubble-mine .bubble-time { color: var(--sand-00-a70); }
.bubble-theirs .bubble-time { color: var(--slate-40); }

.thread-empty { font-size: 16px; color: var(--slate-50); -unity-text-align: middle-center; margin-top: 30px; white-space: normal; }

/* One tap is the whole message. Most encouragement should cost nothing. */
.quick-row { flex-direction: row; flex-wrap: wrap; margin-top: 10px; }
.quick-chip {
    height: 30px;
    padding: 0 14px;
    margin-right: 6px;
    margin-bottom: 6px;
    border-radius: 15px;
    border-width: 1px;
    border-color: var(--slate-50-a32);
    background-color: var(--sand-00-a95);
    color: var(--prussian-50);
    font-size: 15px;
}
.quick-chip:hover { background-color: var(--cerulean-10-a95); border-color: var(--cerulean-50); }

.composer { flex-direction: row; align-items: center; margin-top: 8px; }
.composer-text { flex-grow: 1; height: 44px; font-size: 16px; margin-right: 6px; }
.send-button {
    min-width: 84px;
    height: 36px;
    margin-left: 6px;
    padding: 0 18px;
    border-radius: 18px;
    background-color: var(--prussian-50);
    color: var(--sand-00);
    font-size: 16px;
    -unity-font-style: bold;
    border-width: 0;
}
.send-button:hover { background-color: var(--cerulean-50); }


/* ---- Spotlight: one friend, on the landing page ---------------------------
   Shows a message a friend actually sent. When there is none it states the
   friendship rather than inventing a quote — putting words in a real person's
   mouth would be a betrayal of someone at a low point. */
.friend-spotlight {
    flex-direction: row;
    align-items: center;
    align-self: flex-end;
    max-width: 460px;
    margin-top: 12px;
    padding: 10px 14px 10px 10px;
    border-radius: 24px;
    background-color: var(--sand-00-a95);
    border-width: 2px;
    border-color: var(--sand-00-a80);
}
.friend-spotlight.hidden { display: none; }
.spotlight-face { width: 40px; height: 40px; border-radius: 20px; margin-right: 10px; flex-shrink: 0; }
.spotlight-copy { flex-direction: column; flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.spotlight-name { font-size: 17px; color: var(--prussian-50); -unity-font-style: bold; }
.spotlight-line { font-size: 17px; color: var(--prussian-50); white-space: normal; margin-top: 1px; }
.spotlight-reply {
    flex-shrink: 0;
    margin-left: 10px;
    padding: 7px 16px;
    border-radius: 18px;
    font-size: 17px;
}
.spotlight-reply:hover { background-color: var(--cerulean-10-a95); border-color: var(--cerulean-50); }

.thread-hint { font-size: 15px; color: var(--slate-50); margin-left: 10px; white-space: normal; flex-shrink: 1; }

/* A per-row Message button, so sending is never hidden behind selection. */
.message-pill {
    flex-shrink: 0;
    min-width: 64px;
    height: 26px;
    margin-left: 6px;
    padding: 0 12px;
    font-size: 14px;
    border-radius: 13px;
    border-width: 0;
    background-color: var(--slate-50-a28);
    color: var(--prussian-50);
}
.message-pill:hover { background-color: var(--slate-50-a28); }

/* A pane standing in the ring is the surface itself, so it needs no shade behind it — there is nothing
   behind it. It only has to fill its panel and centre what it carries. */
.pane-screen {
    flex-grow: 1;
    /* Cut to the board's bento block, measured off the board itself: 1504 x 687 starting 179px down.
       179 is the board's own 38px top padding plus its splash row (121) plus that row's 20px margin, so
       a pane's surface begins exactly where the tiles begin and ends where they end. The greeting is
       deliberately outside it — it belongs to the board, and a pane that copied its height would stand
       taller than the thing it sits beside. */
    padding: 179px 48px 34px;
}

/* One pane, one surface, and every surface the same block. These were a modal sheet (1180px) and an
   overlay panel (980px) floating on a board that fills all 1600 — three widths, which did not matter
   while only one was ever on screen. It matters now: the neighbours' edges are visible as the ring
   turns, so three widths read as three different kinds of thing, and the sliver either side changes
   size depending on which pane happens to be standing there. */
.pane-screen > .sheet,
.pane-screen > .friends-panel { width: 100%; height: 100%; }
