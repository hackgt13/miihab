<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:k="Kinesthetic.UI">
    <ui:Style src="../Palette.uss" />
    <ui:Style src="MainMenu.uss" />
    <!-- Friends, one quarter-turn to the right. Two pages behind one header: the
         people you already have, and the people you might. Meeting someone is its
         own page so the roster stays a list of conversations rather than a list
         with strangers mixed into it. -->
    <ui:VisualElement name="friends-pane" class="pane-screen">
        <ui:VisualElement name="friends-panel" class="friends-panel">
            <ui:VisualElement class="friends-header">
                <ui:VisualElement class="friends-heading">
                    <ui:Label text="Friends" class="friends-title" />
                    <ui:Label name="friends-subtitle" text="People who know how this feels." class="friends-subtitle" />
                </ui:VisualElement>
                <ui:VisualElement class="friends-tabs">
                    <k:KButton name="tab-messages" text="Messages" tone="Primary" size="Medium" />
                    <k:KButton name="tab-meet" text="Meet people" tone="Quiet" size="Medium" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page one: who you know, and what you are saying to them. -->
            <ui:VisualElement name="page-messages" class="friends-body">
                <ui:VisualElement class="friends-list-pane">
                    <ui:ScrollView name="friends-list" class="friends-list" />
                </ui:VisualElement>
                <ui:VisualElement class="thread-pane">
                    <ui:VisualElement class="thread-head">
                        <ui:VisualElement name="thread-face" class="thread-face" picking-mode="Ignore" />
                        <ui:Label name="thread-name" text="Pick someone to cheer on" class="thread-name" />
                        <ui:Label name="thread-hint" text="" class="thread-hint" />
                    </ui:VisualElement>
                    <ui:ScrollView name="thread" class="thread" />
                    <!-- Over the thread, not beside it: a profile is something you
                         look at, then go back from. -->
                    <ui:VisualElement name="friend-profile" class="friend-profile hidden">
                        <ui:VisualElement class="profile-head">
                            <ui:VisualElement name="profile-face" class="spotlight-face profile-face" picking-mode="Ignore" />
                            <ui:VisualElement class="profile-titles">
                                <k:KText name="profile-name" text="" size="Heading" tone="Ink" />
                                <k:KText name="profile-goal" text="" size="Caption" tone="Soft" />
                            </ui:VisualElement>
                            <k:KButton name="profile-close" text="Back" tone="Quiet" size="Small" />
                        </ui:VisualElement>
                        <ui:VisualElement name="profile-stats" class="profile-stats" />
                        <ui:VisualElement name="profile-days" class="profile-days" picking-mode="Ignore" />
                        <k:KText name="profile-note" text="" size="Caption" tone="Soft" />
                    </ui:VisualElement>
                    <ui:VisualElement class="composer">
                        <k:KField name="composer-text" placeholder="Write a message…" class="composer-text" max-length="240" />
                        <ui:Button name="composer-photo" text="Photo" class="ghost-button" />
                        <ui:Button name="composer-send" text="Send" class="send-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Page two: one introduction at a time, and the code exchange for
                 someone you already know away from the app. -->
            <ui:VisualElement name="page-meet" class="friends-body hidden">
                <ui:VisualElement class="meet-column">
                    <k:KText text="Someone working toward the same thing" size="Caption" tone="Soft" class="meet-heading" />
                    <ui:VisualElement name="introductions" class="introductions" />
                    <k:KText name="meet-empty" text="No one new right now. We will keep looking." size="Body" tone="Soft" class="meet-empty hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="meet-column">
                    <k:KText text="Already know someone here?" size="Caption" tone="Soft" class="meet-heading" />
                    <ui:VisualElement class="invite-block">
                        <ui:Button name="friends-invite" text="Invite a friend" class="ghost-button" />
                        <ui:Label name="invite-code" text="" class="invite-code hidden" />
                        <ui:VisualElement class="code-row">
                            <k:KField name="friends-code" placeholder="Their 6-letter code" class="code-field" max-length="6" />
                            <ui:Button name="friends-accept" text="Add" class="ghost-button" />
                        </ui:VisualElement>
                        <ui:Label name="friends-notice" text="" class="friends-notice" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
