<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="../Palette.uss" />
    <ui:Style src="MainMenu.uss" />
    <ui:VisualElement name="menu-screen" class="menu-screen">
        <ui:VisualElement class="menu-content">

            <ui:VisualElement class="splash-row">
                <ui:VisualElement class="splash-copy">
                    <ui:Label name="splash-greeting" text="Welcome back!" class="splash-greeting" />
                    <ui:Label name="splash-sub" text="Today" class="splash-sub" />
                </ui:VisualElement>
                <ui:VisualElement class="splash-side">
                    <ui:VisualElement class="utility-cluster">
                        <ui:Button name="friends" class="friends-button" tooltip="Your friends">
                            <ui:VisualElement name="friends-faces" class="friends-faces" picking-mode="Ignore" />
                            <ui:Label name="friends-label" text="Friends" class="friends-label" picking-mode="Ignore" />
                            <ui:Label name="friends-badge" text="" class="friends-badge hidden" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="edit-name" text="Not you?" class="utility-button" />
                        <ui:Button name="music" text="Music: On" class="utility-button" />
                        <ui:Button name="help" text="How to play" class="utility-button" />
                    </ui:VisualElement>
                    <ui:VisualElement name="friend-spotlight" class="friend-spotlight hidden">
                        <ui:VisualElement name="spotlight-face" class="spotlight-face" picking-mode="Ignore" />
                        <ui:VisualElement class="spotlight-copy" picking-mode="Ignore">
                            <ui:Label name="spotlight-name" text="" class="spotlight-name" picking-mode="Ignore" />
                            <ui:Label name="spotlight-line" text="" class="spotlight-line" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Button name="spotlight-reply" text="Say something back" class="spotlight-reply" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="bento">

                <ui:VisualElement class="bento-main">

                    <ui:VisualElement class="tile tile-hero">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="HOW FAR YOU REACH" class="tile-label" />
                            <ui:Label name="data-note" text="" class="tile-note" />
                        </ui:VisualElement>
                        <ui:VisualElement class="hero-body" picking-mode="Ignore">
                            <ui:VisualElement class="hero-readout" picking-mode="Ignore">
                                <ui:Label name="reach-delta" text="" class="reach-delta" />
                                <ui:Label name="reach-now" text="—" class="stat-number" />
                                <ui:Label name="reach-best" text="" class="reach-best" />
                                <ui:Label name="reach-cheer" text="" class="reach-cheer" />
                            </ui:VisualElement>
                            <ui:VisualElement name="range-fan" class="range-fan" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="tile tile-progress">
                        <ui:VisualElement class="progress-split" picking-mode="Ignore">
                            <ui:VisualElement class="progress-cell" picking-mode="Ignore">
                                <ui:VisualElement class="ring-wrap" picking-mode="Ignore">
                                    <ui:VisualElement name="program-ring" class="program-ring" picking-mode="Ignore" />
                                    <ui:VisualElement class="ring-centre" picking-mode="Ignore">
                                        <ui:Label name="ring-number" text="0" class="ring-number" />
                                        <ui:Label name="ring-caption" text="" class="ring-caption" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="progress-rule" picking-mode="Ignore" />
                            <ui:VisualElement class="progress-cell" picking-mode="Ignore">
                                <ui:Label name="streak-number" text="0" class="streak-number" />
                                <ui:Label text="DAY STREAK" class="tile-label" />
                                <ui:Label name="streak-caption" text="" class="stat-caption" />
                            </ui:VisualElement>
                            <ui:VisualElement class="progress-rule" picking-mode="Ignore" />
                            <ui:VisualElement class="progress-cell goal-cell" picking-mode="Ignore">
                                <ui:Label text="WORKING TOWARD" class="tile-label" />
                                <ui:Label name="goal-copy" text="" class="goal-copy" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button name="start-activity" class="cta">
                        <ui:VisualElement class="cta-copy" picking-mode="Ignore">
                            <ui:Label name="cta-title" text="Start first activity" class="cta-title" picking-mode="Ignore" />
                            <ui:Label name="cta-sub" text="" class="cta-sub" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label text="›" class="cta-arrow" picking-mode="Ignore" />
                    </ui:Button>

                </ui:VisualElement>

                <ui:VisualElement class="bento-side">

                    <ui:VisualElement class="tile tile-calendar">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="CONSISTENCY" class="tile-label" />
                            <ui:Label name="calendar-note" text="" class="tile-note accent" />
                        </ui:VisualElement>
                        <ui:VisualElement class="calendar-days" picking-mode="Ignore">
                            <ui:Label text="M" class="day-letter" /><ui:Label text="T" class="day-letter" />
                            <ui:Label text="W" class="day-letter" /><ui:Label text="T" class="day-letter" />
                            <ui:Label text="F" class="day-letter" /><ui:Label text="S" class="day-letter" />
                            <ui:Label text="S" class="day-letter" />
                        </ui:VisualElement>
                        <ui:VisualElement name="calendar-grid" class="calendar-grid" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement class="tile tile-today">
                        <ui:VisualElement class="tile-head" picking-mode="Ignore">
                            <ui:Label text="TODAY" class="tile-label" />
                            <ui:Label name="week-count" text="" class="tile-note accent" />
                        </ui:VisualElement>
                        <ui:VisualElement name="today-list" class="today-list" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:Button name="choose-activity" class="tile tile-action">
                        <ui:VisualElement class="action-copy" picking-mode="Ignore">
                            <ui:Label text="Choose activity" class="action-title" picking-mode="Ignore" />
                            <ui:Label text="Browse everything you can play" class="action-sub" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement name="browse-glyph" class="browse-glyph" picking-mode="Ignore" />
                    </ui:Button>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="name-overlay" class="modal-shade hidden">
            <ui:VisualElement class="sheet name-sheet">
                <ui:Label text="What should we call you?" class="sheet-title" />
                <ui:TextField name="name-field" class="name-field" max-length="24" />
                <ui:Label text="Just for the greeting. It stays on this machine." class="help-copy" />
                <ui:VisualElement class="sheet-actions">
                    <ui:Button name="name-cancel" text="Cancel" class="sheet-close" />
                    <ui:Button name="name-save" text="Save  ›" class="sheet-close primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>


        <ui:VisualElement name="help-overlay" class="modal-shade hidden">
            <ui:VisualElement class="sheet help-sheet">
                <ui:Label text="Ready when you are." class="sheet-title" />
                <ui:Label text="Golf" class="help-heading" />
                <ui:Label text="Choose Golf, then use the camera button to start tracking. Calibrate your mounted club before your first swing." class="help-copy" />
                <ui:Label text="Movement Studio" class="help-heading" />
                <ui:Label text="Sit comfortably with your shoulders, arms, and hips in view. Start your session and follow the target in your prescribed plan." class="help-copy" />
                <ui:Label text="Bowling" class="help-heading" />
                <ui:Label text="Today we will practice bowling. Secure your AirPod at your wrist, face down the lane, and hold still. Swing gently to roll." class="help-copy" />
                <ui:Label text="Getting around" class="help-heading" />
                <ui:Label text="Look at a panel and hold your gaze to choose it, or click. Press Esc or choose Menu during an activity to return here." class="help-copy" />
                <ui:Button name="help-close" text="Let's play  ›" class="sheet-close primary" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
