/* The briefing sheet: a form, read once. Narrower than the board it stands on, because a document has a
   measure and a board does not, and ruled between its lines so the dose reads as a prescription rather
   than as a row of statistics. */
/* The sheet is the page: it fills the board, which is cut to the size of real paper, so what you are
   handed is a sheet rather than a card floating on one. */
.k-briefing {
    flex-grow: 1;
    flex-shrink: 1;
    align-self: stretch;
}

.k-briefing .hidden { display: none; }

.k-briefing__subtitle { margin-top: 4px; }

/* The dose. One ruled row per line, label left and figure right, the way a form is read. */
.k-briefing__lines { margin-top: 18px; }
.k-briefing__line {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    /* Not baseline: a value that wraps to two lines drops its baseline to the second one, and the field
       name then sits a line below the figure it names. Top-aligned, with the smaller label nudged down
       to sit on the same optical line as the larger figure beside it. */
    align-items: flex-start;
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sand-30);
}

/* The field name is never broken. It is the shorter half and the one you scan down the page, and a
   label squeezed to one letter a line — which is what shrinking the label instead of the value did —
   stops being a word at all. */
.k-briefing__line-label { flex-shrink: 0; white-space: nowrap; padding-top: 3px; }

/* The figure takes what is left and wraps inside its own column. Right-aligned, so the column reads
   down the page whether its entries are two characters or a sentence. */
.k-briefing__line-value {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 16px;
    -unity-text-align: upper-right;
}

/* Words a person wrote, set apart from the figures and marked down the edge like a margin note. */
.k-briefing__note {
    margin-top: 16px;
    padding: 12px 14px;
    background-color: var(--sand-10);
    border-left-width: 3px;
    border-left-color: var(--cerulean-40);
    border-radius: 8px;
}
.k-briefing__note-from { margin-bottom: 4px; }

/* Whatever the page has left over, so the action lands at its foot however much is written above. */
.k-briefing__slack { flex-grow: 1; min-height: 16px; }

/* At the foot of the page, where a form is signed. */
.k-briefing__action { align-self: flex-end; }
