/* KChip. The dot carries the state, in the family whose meaning matches it; the fill and lettering follow
   the palette's -60 on -10 pairing. */

.k-chip.k-chip--idle, .k-chip.k-chip--live, .k-chip.k-chip--good, .k-chip.k-chip--trouble {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    margin: 0;
    padding: 10px 15px;
    border-radius: 18px;
    border-width: 0;
}

.k-chip .k-chip__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin: 0 8px 0 0;
    flex-shrink: 0;
}

.k-chip .k-chip__label {
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-font: url("project://database/Assets/Kinesthetic/Rehab/Fonts/Nunito-SemiBold.ttf");
    -unity-font-style: normal;
    white-space: nowrap;
}

.k-chip.k-chip--idle    { background-color: var(--sand-20); }
.k-chip.k-chip--idle    .k-chip__dot   { background-color: var(--slate-30); }
.k-chip.k-chip--idle    .k-chip__label { color: var(--slate-60); }

.k-chip.k-chip--live    { background-color: var(--cerulean-10); }
.k-chip.k-chip--live    .k-chip__dot   { background-color: var(--cerulean-50); }
.k-chip.k-chip--live    .k-chip__label { color: var(--cerulean-60); }

.k-chip.k-chip--good    { background-color: var(--jungle-10); }
.k-chip.k-chip--good    .k-chip__dot   { background-color: var(--jungle-40); }
.k-chip.k-chip--good    .k-chip__label { color: var(--jungle-60); }

.k-chip.k-chip--trouble { background-color: var(--coral-10); }
.k-chip.k-chip--trouble .k-chip__dot   { background-color: var(--coral-40); }
.k-chip.k-chip--trouble .k-chip__label { color: var(--coral-60); }
