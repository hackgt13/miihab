/* A pane's own look: the frame and the grip it is dragged by. The title is a KText and the close
   button a KButton, so they carry their own sheets and look like every other one.

   Every selector is at least two classes, as in every other library component, so nothing a
   pane's content brings with it can outrank the frame. Colour comes only from Palette.uss, which
   Pane.uxml links first. */

.k-pane.k-pane--idle, .k-pane.k-pane--focused {
    flex-grow: 1;
    overflow: hidden;
    background-color: var(--sand-10);
    border-width: 2px;
    border-radius: 22px;
    border-color: var(--slate-30);
}

/* Focus is a border, not a shadow: USS has no box-shadow. */
.k-pane.k-pane--focused { border-color: var(--cerulean-50); }

.k-pane .k-pane__grip {
    flex-direction: row;
    align-items: center;
    height: 46px;
    padding: 0 5px 0 18px;
    background-color: var(--sand-30);
}

/* Hover comes from the raycast (Pane.Highlight), because :hover never fires on a world-space
   panel. It is the same k-hot a KButton answers to. */
.k-pane .k-pane__grip.k-hot { background-color: var(--cerulean-20); }

.k-pane .k-pane__grip-space { flex-grow: 1; }

.k-pane .k-pane__content {
    flex-grow: 1;
    background-color: var(--sand-00);
}

/* Content: a page of text, and the line a pane shows instead of content that failed to load. */
.k-pane .k-pane__reading { padding: 18px 22px 22px 22px; }

.k-pane .k-pane__problem {
    margin: 0;
    padding: 16px 18px 0 18px;
    font-size: 15px;
    color: var(--coral-60);
    white-space: normal;
}
